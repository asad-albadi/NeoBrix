[Unit]
Description=Neobrix Quickshell desktop shell
Documentation=https://quickshell.org
PartOf=graphical-session.target
After=graphical-session.target
# Without a compositor there is nothing to draw on.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# -c selects ~/.config/quickshell/neobrix/shell.qml.
ExecStart=/usr/bin/qs -c neobrix
# Ask the running shell to reload its QML in place. SIGUSR1 terminates current
# Quickshell releases rather than reloading them, losing notification history.
ExecReload=/usr/bin/qs -c neobrix ipc call shell reload
Restart=on-failure
RestartSec=2
Slice=session.slice
TimeoutStopSec=5sec

[Install]
WantedBy=graphical-session.target
