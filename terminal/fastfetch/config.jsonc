// Neobrix fastfetch layout.
//
// Grouped into boxed sections with tree-style keys instead of one flat list. The
// layout grammar — grey box rules, "| |-" continuation keys, one colour per
// section — is modelled on Omarchy's fastfetch config; the modules, icons,
// colours and commands are Neobrix's own.
//
// The logo is left on auto-detect, so this keeps the distro's own logo.
//
// Section colours are ANSI names, not hex, on purpose: the terminal palette is
// generated by `neobrix-theme` from the same source as the shell, so "green"
// here IS Neobrix pistachio and the whole readout follows a dawn/dusk switch
// without this file knowing anything about it.
//   hardware -> green   (pistachio)
//   software -> magenta (lavender)
//   desktop  -> yellow  (peach)
//   age      -> blue    (info)
//
// GENERATED — regenerate with scripts/neobrix-generate-fastfetch rather than
// hand-editing: the Nerd Font icons are Private-Use codepoints that do not
// survive being pasted around.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 2,
      "right": 5,
      "left": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "white"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "keyColor": "green",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "│ ├󰡸",
      "keyColor": "green",
      "detectionMethod": "pci"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "│ ├󰓡",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "└ └󰋊",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "└ └󰏖",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Desktop───────────────────────┐"
    },
    {
      "type": "command",
      "key": "󰸌 Neobrix",
      "keyColor": "yellow",
      "text": "m=$(cat \"${XDG_STATE_HOME:-$HOME/.local/state}/neobrix/theme\" 2>/dev/null); [ -n \"$m\" ] || m=dawn; printf '%s  \\033[33m●\\033[32m●\\033[35m●\\033[95m●\\033[34m●\\033[36m●\\033[0m' \"$m\""
    },
    {
      "type": "theme",
      "key": "│ ├󰉼",
      "keyColor": "yellow"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "yellow"
    },
    {
      "type": "terminalfont",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "cursor",
      "key": "└ └󰇀",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────────Age / Uptime / Update────────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "blue",
      "text": "b=$(stat -c %W / 2>/dev/null); if [ -n \"$b\" ] && [ \"$b\" -gt 0 ]; then echo \"$(( ($(date +%s) - b) / 86400 )) days\"; else echo unknown; fi"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "blue",
      "text": "n=$(checkupdates 2>/dev/null | wc -l); if [ \"$n\" -gt 0 ]; then echo \"$n packages\"; else echo \"up to date\"; fi"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
