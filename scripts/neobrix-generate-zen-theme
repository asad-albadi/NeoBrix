#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  Apply the Neobrix palette to Zen Browser.
#
#      neobrix-generate-zen-theme
#
#  Deliberately mode-independent. An earlier version took dawn|dusk and wrote the
#  matching colours plus prefs that pinned the scheme
#  (layout.css.prefers-color-scheme.content-override, ui.systemUsesDarkTheme,
#  browser.theme.*). That was self-defeating: those prefs are read at startup, so
#  a running browser could never follow a palette toggle — and worse, pinning the
#  content scheme meant Dark Reader's "System" automation never saw a change
#  either, so web pages stayed on one scheme regardless of the desktop.
#
#  Instead both palettes go into one stylesheet gated on `prefers-color-scheme`,
#  and no scheme-pinning prefs are set at all. Firefox tracks the desktop's colour
#  scheme through the XDG portal, and `neobrix-theme` already sets that via
#  gsettings — so browser chrome, web content and Dark Reader all follow a
#  dawn/dusk toggle live, with no restart and nothing to regenerate.
#
#  Written into the profile rather than symlinked from the repo: the profile
#  directory name is machine-specific (random prefix), and Zen rewrites prefs.js
#  itself. Same reasoning as the GTK/Qt/kdeglobals files.
#
#  Zen must be restarted once for userChrome/userContent to be loaded at all;
#  after that, palette switches need no restart.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/palette.sh
source "$HERE/lib/palette.sh"

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
ZEN="$CFG/zen"
[[ -d "$ZEN" ]] || { echo "neobrix-generate-zen-theme: no Zen profile directory at $ZEN" >&2; exit 0; }

# Every real profile (one with prefs.js). Zen ships more than one profile entry
# and the "Profile Groups" directory is not a profile at all.
mapfile -t PROFILES < <(find "$ZEN" -maxdepth 2 -name prefs.js -printf '%h\n' | sort)
(( ${#PROFILES[@]} )) || { echo "neobrix-generate-zen-theme: no Zen profile with prefs.js yet — start Zen once first" >&2; exit 0; }

BEGIN="/* ==== neobrix:begin (generated by neobrix-generate-zen-theme) ==== */"
END="/* ==== neobrix:end ==== */"
JS_BEGIN="// ==== neobrix:begin (generated by neobrix-generate-zen-theme) ===="
JS_END="// ==== neobrix:end ===="

# Replace our managed block in a file, leaving anything else the user has alone.
splice() { # <file> <begin> <end> ; new content on stdin
    local file="$1" begin="$2" end="$3" body
    body="$(cat)"
    mkdir -p "$(dirname "$file")"
    [[ -f "$file" ]] || : > "$file"
    python3 - "$file" "$begin" "$end" "$body" <<'PY'
import sys, pathlib
path, begin, end, body = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
p = pathlib.Path(path)
text = p.read_text() if p.exists() else ""
block = f"{begin}\n{body}\n{end}\n"
if begin in text and end in text:
    head = text.split(begin)[0]
    tail = text.split(end, 1)[1].lstrip("\n")
    text = head + block + tail
else:
    text = (text.rstrip("\n") + "\n\n" if text.strip() else "") + block
p.write_text(text)
PY
}

# The palette custom properties for one mode.
vars_for() {
    neobrix_palette "$1"
    cat <<EOF
  --neobrix-bg:      #$DESKTOP;
  --neobrix-surface: #$BG;
  --neobrix-alt:     #$SURFACE_ALT;
  --neobrix-deep:    #$BG_DEEP;
  --neobrix-fg:      #$FG;
  --neobrix-dim:     #$FG_DIM;
  --neobrix-outline: #$OUTLINE;
  --neobrix-accent:  #$PRIMARY;
EOF
}

neobrix_palette dawn
DAWN_ACCENT="$PRIMARY"

for P in "${PROFILES[@]}"; do
    # ── prefs ───────────────────────────────────────────────────────────────
    # Only what cannot be expressed in CSS. No scheme pinning — the portal decides,
    # so the browser follows the desktop live.
    splice "$P/user.js" "$JS_BEGIN" "$JS_END" <<EOF
// Neobrix — palette-independent; the colour scheme follows the desktop via the
// XDG portal, which is what makes a dawn/dusk toggle reach the browser live.
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
// Zen's accent is a single value and cannot be scheme-dependent. The two palette
// accents are close (#f6a97e / #f0a377), so the light one reads correctly in both.
user_pref("zen.theme.accent-color", "#$DAWN_ACCENT");
// Neobrix draws window borders, so Zen should not add its own titlebar.
user_pref("browser.tabs.inTitlebar", 1);
// Explicitly returned to "follow the system" rather than simply dropped. An
// earlier version of this script pinned these, Zen copied them into prefs.js at
// startup, and removing a line from user.js does not reset a pref that is already
// set — so they would have gone on overriding the portal forever. 2 = system.
user_pref("layout.css.prefers-color-scheme.content-override", 2);
user_pref("browser.theme.toolbar-theme", 2);
user_pref("browser.theme.content-theme", 2);
EOF

    # ── unset the prefs an earlier version pinned ────────────────────────────
    # ui.systemUsesDarkTheme has no "auto" value, so it cannot be neutralised from
    # user.js — once set it overrides the portal permanently. The only way to clear
    # it is to delete the line from prefs.js, and that is only safe while Zen is
    # closed, because Zen rewrites the whole file on shutdown.
    if [[ ! -e "$P/lock" && -f "$P/prefs.js" ]]; then
        if grep -q 'ui.systemUsesDarkTheme' "$P/prefs.js"; then
            cp -a "$P/prefs.js" "$P/prefs.js.neobrix-bak"
            sed -i '/user_pref("ui\.systemUsesDarkTheme"/d' "$P/prefs.js"
            printf '  cleared the pinned ui.systemUsesDarkTheme (backup: prefs.js.neobrix-bak)\n'
        fi
    elif [[ -e "$P/lock" ]] && grep -q 'ui.systemUsesDarkTheme' "$P/prefs.js" 2>/dev/null; then
        printf '  NOTE: ui.systemUsesDarkTheme is still pinned in prefs.js; quit Zen and\n'
        printf '        re-run this script to clear it, or the browser will not follow the\n'
        printf '        palette.\n'
    fi

    # ── browser UI ──────────────────────────────────────────────────────────
    {
        printf ':root {\n'
        vars_for dawn
        printf '}\n\n'
        printf '/* Dusk. Gated on the system scheme rather than generated per-mode, so a\n'
        printf '   palette toggle re-styles a running browser with no restart. */\n'
        printf '@media (prefers-color-scheme: dark) {\n  :root {\n'
        vars_for dusk | sed 's/^/  /'
        printf '  }\n}\n\n'
        cat <<'EOF'
:root {
  --toolbar-bgcolor:                      var(--neobrix-alt) !important;
  --toolbar-color:                        var(--neobrix-fg) !important;
  --toolbar-field-background-color:       var(--neobrix-surface) !important;
  --toolbar-field-color:                  var(--neobrix-fg) !important;
  --toolbar-field-border-color:           var(--neobrix-outline) !important;
  --toolbar-field-focus-background-color: var(--neobrix-surface) !important;
  --toolbar-field-focus-border-color:     var(--neobrix-accent) !important;
  --tab-selected-bgcolor:                 var(--neobrix-surface) !important;
  --tab-selected-textcolor:               var(--neobrix-fg) !important;
  --lwt-accent-color:                     var(--neobrix-alt) !important;
  --lwt-text-color:                       var(--neobrix-fg) !important;
  --arrowpanel-background:                var(--neobrix-surface) !important;
  --arrowpanel-color:                     var(--neobrix-fg) !important;
  --arrowpanel-border-color:              var(--neobrix-outline) !important;
  --panel-background:                     var(--neobrix-surface) !important;
  --panel-background-color:               var(--neobrix-surface) !important;
  --panel-color:                          var(--neobrix-fg) !important;
  --panel-border-color:                   var(--neobrix-outline) !important;
  --focus-outline-color:                  var(--neobrix-accent) !important;

  /* Zen's own properties, read out of browser/omni.ja rather than guessed.
     --zen-main-browser-background* are what actually paint the vertical tab
     sidebar; setting only --zen-colors-* leaves it untouched. */
  --zen-primary-color:                    var(--neobrix-accent) !important;
  --zen-main-browser-background:          var(--neobrix-alt) !important;
  --zen-main-browser-background-toolbar:  var(--neobrix-alt) !important;
  --zen-themed-toolbar-bg-transparent:    var(--neobrix-alt) !important;
  --zen-themed-toolbar-bg:                var(--neobrix-alt) !important;
  --zen-toolbar-element-bg:               var(--neobrix-deep) !important;
  --zen-colors-primary:                   var(--neobrix-alt) !important;
  --zen-colors-primary-foreground:        var(--neobrix-fg) !important;
  --zen-colors-secondary:                 var(--neobrix-surface) !important;
  --zen-colors-tertiary:                  var(--neobrix-deep) !important;
  --zen-colors-border:                    var(--neobrix-outline) !important;
  --zen-colors-border-contrast:           var(--neobrix-outline) !important;
  --zen-colors-input-bg:                  var(--neobrix-surface) !important;
  --zen-colors-hover-bg:                  var(--neobrix-deep) !important;
  --zen-dialog-background:                var(--neobrix-surface) !important;
}

/* The sidebar strip itself. */
#navigator-toolbox,
#titlebar,
#TabsToolbar,
#zen-sidebar-top-buttons,
#zen-tabbox-wrapper {
  background-color: var(--neobrix-alt) !important;
  color: var(--neobrix-fg) !important;
}

#zen-sidebar-splitter {
  background-color: var(--neobrix-outline) !important;
}

/* Chunky outline on the address bar, flat fill, modest radius — BrixCard
   geometry rather than Firefox's pill. */
#urlbar,
#searchbar {
  border: 2px solid var(--neobrix-outline) !important;
  border-radius: 7px !important;
}
#urlbar[focused="true"] {
  border-color: var(--neobrix-accent) !important;
}

/* Tabs read as blocks: a real border on the active one, none on the rest. */
.tab-background[selected] {
  border: 2px solid var(--neobrix-outline) !important;
  border-radius: 7px !important;
}

/* Menus and popups. The border is NOT on the menupopup/panel element — Firefox
   draws it on the shadow-DOM ::part(content) as "1px solid
   var(--panel-border-color)", so styling the host only ever produced the thin
   default outline. */
menupopup,
panel {
  --panel-border-radius: 7px !important;
}

menupopup::part(content),
panel::part(content),
#PopupAutoComplete::part(content),
#PopupSearchAutoComplete::part(content) {
  border: 2px solid var(--neobrix-outline) !important;
  border-radius: 7px !important;
  background-color: var(--neobrix-surface) !important;
}

/* Flat rules only — no blurred separators. */
#navigator-toolbox {
  border-bottom: 2px solid var(--neobrix-outline) !important;
}
EOF
    } | splice "$P/chrome/neobrix.css" "$BEGIN" "$END"

    # userChrome.css is the file Zen actually loads; keep it a thin importer so
    # anything the user adds themselves survives.
    splice "$P/chrome/userChrome.css" "$BEGIN" "$END" <<'EOF'
@import url("neobrix.css");
EOF

    # ── internal pages ──────────────────────────────────────────────────────
    # Both schemes again, so about:blank and a new tab follow live too.
    {
        neobrix_palette dawn
        cat <<EOF
@-moz-document url-prefix("about:blank"), url("about:newtab"), url("about:home") {
  :root, body { background: #$DESKTOP !important; color: #$FG !important; }
}
EOF
        neobrix_palette dusk
        cat <<EOF

@media (prefers-color-scheme: dark) {
  @-moz-document url-prefix("about:blank"), url("about:newtab"), url("about:home") {
    :root, body { background: #$DESKTOP !important; color: #$FG !important; }
  }
}
EOF
    } | splice "$P/chrome/userContent.css" "$BEGIN" "$END"

    printf 'themed %s\n' "${P/#$HOME/~}"
done

printf 'restart Zen once to load the stylesheets; palette switches then apply live\n'
