#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  Match the machine's power policy to what it is running on.
#
#      neobrix-power auto        follow the current power source
#      neobrix-power battery     apply the battery policy
#      neobrix-power mains       apply the mains policy
#      neobrix-power status      print what is in force
#
#  The shell calls `auto` whenever UPower reports the power source changed; it
#  is safe to run by hand or from a bind.
#
#  Two things are changed, both measured on an i5-11300H with an RTX 3050:
#
#    * The power profile. power-saver rather than performance costs 0.7 W less
#      at the CPU package (3.95 W against 3.30 W, three interleaved rounds).
#      The profile in force when the cable comes out is remembered and put back
#      when it goes in, so a deliberate choice survives a trip to the sofa.
#
#    * The internal panel's refresh rate. 60 Hz rather than 144 Hz saves 0.31 W
#      and halves Hyprland's idle CPU (1.42% to 0.67%). Only outputs whose name
#      starts eDP are touched, and only their mode -- an external display is
#      somebody's deliberate desk setup and is left exactly as it is.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/power.sh
source "$HERE/lib/power.sh"

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/neobrix"
PROFILE_STATE="$STATE_DIR/power-profile-on-mains"

have() { command -v "$1" >/dev/null 2>&1; }

set_profile() {
    have powerprofilesctl || return 0
    powerprofilesctl list 2>/dev/null | grep -q "^[* ] *$1:" || return 0
    powerprofilesctl set "$1" 2>/dev/null || true
}

current_profile() { have powerprofilesctl && powerprofilesctl get 2>/dev/null || echo ""; }

# Only the mode is rewritten. Position and scale are read back from the running
# configuration and passed through unchanged, because "auto" would re-place the
# output and rearrange a multi-monitor desk.
set_internal_mode() {
    local want=$1
    have hyprctl || return 0
    NB_WANT="$want" python3 - <<'PY'
import json, os, subprocess, sys

want = os.environ["NB_WANT"]
try:
    out = subprocess.run(["hyprctl", "-j", "monitors"],
                         capture_output=True, text=True, check=True).stdout
    monitors = json.loads(out)
except Exception:
    sys.exit(0)

for m in monitors:
    if not m["name"].startswith("eDP"):
        continue
    if want == "preferred":
        mode = "preferred"
    else:
        # Only ask for a rate the panel actually advertises at this resolution.
        target = "{}x{}@{}".format(m["width"], m["height"], want)
        if not any(am.startswith(target) for am in m.get("availableModes", [])):
            continue
        mode = target
    spec = 'hl.monitor({{output="{}", mode="{}", position="{}x{}", scale={}}})'.format(
        m["name"], mode, m["x"], m["y"], m["scale"])
    subprocess.run(["hyprctl", "eval", spec],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
PY
}

apply_battery() {
    mkdir -p "$STATE_DIR"
    local now; now=$(current_profile)
    # Remember only a mains profile, so repeated calls do not record power-saver
    # as the thing to go back to.
    [[ -n $now && $now != power-saver ]] && printf '%s' "$now" > "$PROFILE_STATE"
    set_profile power-saver
    set_internal_mode 60
    echo "battery policy: power-saver, internal panel 60Hz"
}

apply_mains() {
    local back=balanced
    [[ -r $PROFILE_STATE ]] && back=$(cat "$PROFILE_STATE")
    set_profile "$back"
    set_internal_mode preferred
    echo "mains policy: $back, internal panel at its preferred mode"
}

case ${1:-auto} in
    auto)    if neobrix_on_battery; then apply_battery; else apply_mains; fi ;;
    battery) apply_battery ;;
    mains)   apply_mains ;;
    status)
        printf 'source:  %s\n' "$(neobrix_on_battery && echo battery || echo mains)"
        printf 'profile: %s\n' "$(current_profile)"
        have hyprctl && python3 - <<'PY'
import json, subprocess
try:
    out = subprocess.run(["hyprctl", "-j", "monitors"],
                         capture_output=True, text=True, check=True).stdout
except Exception:
    raise SystemExit(0)
for m in json.loads(out):
    print("{:<10} {}x{}@{:.0f}".format(
        m["name"], m["width"], m["height"], m["refreshRate"]))
PY
        ;;
    *) sed -n '2,10p' "$(readlink -f "$0")" | sed 's/^# \?//'; exit 1 ;;
esac
