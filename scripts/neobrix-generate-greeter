#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  Theme the login screen (greetd + ReGreet) with the Neobrix palette.
#
#      neobrix-generate-greeter [dawn|dusk] [outdir]
#
#  Writes regreet.css and regreet.toml. With no outdir it targets /etc/greetd and
#  needs root; pass a directory to generate somewhere writable for testing.
#
#  ReGreet builds its UI programmatically rather than from a .ui template, so
#  there are no custom CSS classes to hook — the stylesheet targets generic GTK4
#  selectors (window, frame, entry, button, label). Verified by rendering, not by
#  reading the source, using ReGreet's own `--demo` mode:
#
#      regreet --demo -c <outdir>/regreet.toml -s <outdir>/regreet.css
#
#  That runs the real UI without greetd, so the greeter can be iterated on without
#  ever risking the ability to log in.
#
#  Unlike the rest of the theming this is NOT regenerated on a palette switch: it
#  lives in /etc, which the user-level `neobrix-theme` cannot write. The mode is
#  baked in at generation time — re-run with sudo to change it.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/palette.sh
source "$HERE/lib/palette.sh"

# This script is normally run with sudo, which makes $HOME /root. Resolve the
# invoking user's home instead, or the palette state and wallpapers are not found.
REAL_HOME="$HOME"
if [[ -n "${SUDO_USER:-}" ]]; then
    REAL_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
fi
STATE="${XDG_STATE_HOME:-$REAL_HOME/.local/state}/neobrix/theme"
MODE="${1:-}"
if [[ -z "$MODE" ]]; then
    MODE="$(cat "$STATE" 2>/dev/null || true)"
    [[ "$MODE" == "dawn" || "$MODE" == "dusk" ]] || MODE=dawn
fi
[[ "$MODE" == "dawn" || "$MODE" == "dusk" ]] || { echo "usage: neobrix-generate-greeter [dawn|dusk] [outdir]" >&2; exit 2; }
neobrix_palette "$MODE"

OUT="${2:-/etc/greetd}"
# The greeter runs as the `greeter` user, which cannot read $HOME — the wallpaper
# has to live somewhere world-readable.
WALLDIR="/usr/share/backgrounds/neobrix"
WALL="$WALLDIR/neobrix-$MODE.png"

install_bg() {
    local src="${XDG_DATA_HOME:-$REAL_HOME/.local/share}/neobrix/wallpapers/neobrix-$MODE.png"
    [[ -f "$src" ]] || { echo "  no wallpaper at $src — run neobrix-generate-wallpapers first" >&2; return 0; }
    if [[ -w "$(dirname "$WALLDIR")" || $EUID -eq 0 ]]; then
        install -Dm644 "$src" "$WALL"
        printf '  background: %s\n' "$WALL"
    else
        printf '  skipped installing the background (needs root): %s\n' "$WALL"
    fi
}

mkdir -p "$OUT"

# ── config ──────────────────────────────────────────────────────────────────
cat > "$OUT/regreet.toml" <<EOF
# Generated by neobrix-generate-greeter ($MODE). Do not edit by hand.

# Ask for the user every time. Neobrix has no autologin, so the greeter is the
# only authentication gate.
skip_selection = false

[background]
path = "$WALL"
# Cover, not Contain: the wallpaper is generated at 2560x1440 and Contain would
# letterbox it on any other aspect ratio, showing bare GTK grey at the edges.
fit = "Cover"

[GTK]
application_prefer_dark_theme = $([[ "$MODE" == "dusk" ]] && echo true || echo false)
cursor_theme_name = "Adwaita"
cursor_blink = true
font_name = "JetBrainsMono Nerd Font 12"
icon_theme_name = "$ICONS"
theme_name = "$GTK_THEME"

[appearance]
greeting_msg = "Neobrix"

[widget.clock]
format = "%H:%M"
resolution = "1s"
label_width = 180

[commands]
reboot = ["systemctl", "reboot"]
poweroff = ["systemctl", "poweroff"]
EOF

# ── stylesheet ──────────────────────────────────────────────────────────────
# Hard offset shadows are box-shadow with a zero blur radius — the same trick
# BrixCard uses in QML, expressed in CSS.
cat > "$OUT/regreet.css" <<EOF
/* Generated by neobrix-generate-greeter ($MODE). Do not edit by hand. */

@define-color neobrix_bg      #$DESKTOP;
@define-color neobrix_surface #$BG;
@define-color neobrix_alt     #$SURFACE_ALT;
@define-color neobrix_deep    #$BG_DEEP;
@define-color neobrix_fg      #$FG;
@define-color neobrix_dim     #$FG_DIM;
@define-color neobrix_outline #$OUTLINE;
@define-color neobrix_accent  #$PRIMARY;
@define-color neobrix_onaccent #$ON_ACCENT;
@define-color neobrix_error   #$ERROR;

* {
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 12pt;
}

/* Let the wallpaper through; ReGreet paints it behind the widget tree. */
window,
window.background {
    background-color: transparent;
    color: @neobrix_fg;
}

/* The login card. Flat fill, chunky outline, hard offset shadow. */
/* Heavier than the in-shell card on purpose. In the shell a card sits on a
   panel, so fill contrast carries the edge; here it floats on a wallpaper, where
   a near-black 2px outline on a dark card simply disappears. A 3px outline and a
   deeper hard shadow put the Brix edge back without resorting to a light border,
   which would contradict the dusk palette. */
frame,
frame > box,
.card {
    background-color: @neobrix_surface;
    border: 3px solid @neobrix_outline;
    border-radius: 15px;
    box-shadow: 6px 6px 0 @neobrix_outline;
    padding: 18px;
}

label {
    color: @neobrix_fg;
    font-weight: 700;
}

/* The clock and the greeting carry the display weight. */
label.title-1,
label.title-2 {
    font-size: 30pt;
    font-weight: 800;
}

entry,
passwordentry,
entry.password {
    background-color: @neobrix_alt;
    color: @neobrix_fg;
    border: 2px solid @neobrix_outline;
    border-radius: 7px;
    box-shadow: none;
    padding: 8px 10px;
    caret-color: @neobrix_accent;
}

entry:focus,
passwordentry:focus,
entry:focus-within,
passwordentry:focus-within {
    border-color: @neobrix_accent;
    outline: none;
}

entry image,
passwordentry image {
    color: @neobrix_dim;
}

button {
    background-image: none;
    background-color: @neobrix_deep;
    color: @neobrix_fg;
    border: 2px solid @neobrix_outline;
    border-radius: 7px;
    box-shadow: 3px 3px 0 @neobrix_outline;
    padding: 6px 14px;
    font-weight: 700;
}

button:hover {
    background-color: @neobrix_accent;
    color: @neobrix_onaccent;
}

/* Pressed buttons travel into their own shadow — the Brix press physics. */
button:active {
    box-shadow: none;
    margin: 3px 0 0 3px;
}

button.suggested-action {
    background-color: @neobrix_accent;
    color: @neobrix_onaccent;
}

button.destructive-action {
    background-color: @neobrix_error;
    color: @neobrix_onaccent;
}

/* Session / user pickers. */
combobox button,
dropdown button,
combobox,
dropdown {
    background-color: @neobrix_alt;
    color: @neobrix_fg;
}

popover > contents,
popover contents {
    background-color: @neobrix_surface;
    color: @neobrix_fg;
    border: 2px solid @neobrix_outline;
    border-radius: 7px;
}

/* Error / status text. */
label.error,
.error {
    color: @neobrix_error;
    font-weight: 800;
}
EOF

printf 'wrote %s/regreet.toml and %s/regreet.css (%s)\n' "$OUT" "$OUT" "$MODE"
install_bg
printf '\npreview without touching greetd:\n'
printf '  regreet --demo -c %s/regreet.toml -s %s/regreet.css\n' "$OUT" "$OUT"
