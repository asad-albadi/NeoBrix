#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  Monitor layout: read it, change it, remember it.
#
#      neobrix-monitors list                    what is connected, as a table
#      neobrix-monitors state                   the same thing as JSON
#      neobrix-monitors fingerprint             the key this set of outputs saves under
#
#      neobrix-monitors set OUTPUT KEY=VAL ...  change one output
#      neobrix-monitors apply [profile]         apply a saved profile
#      neobrix-monitors save [name]             save the current layout as a profile
#      neobrix-monitors profiles                list saved profiles
#      neobrix-monitors forget <name>           delete a profile
#
#      neobrix-monitors confirm                 keep a pending change
#      neobrix-monitors revert                  undo a pending change
#      neobrix-monitors generate                write the Lua applied at startup
#      neobrix-monitors arrange                 pack the screens edge to edge
#      neobrix-monitors cap <hz>                cap the internal panel's refresh
#      neobrix-monitors uncap                   put the internal panel back
#
#  Options for `set` and `apply`:
#      --revert-after N   snapshot first and put it back after N seconds unless
#                         `confirm` arrives. A mode a monitor cannot display
#                         leaves a black screen, and a black screen cannot be
#                         clicked out of, so anything driven from the GUI goes
#                         through this. The watcher is detached: it restores the
#                         display even if the shell that asked for the change
#                         dies in the middle of it.
#
#  Why hyprctl eval rather than hyprctl keyword: Neobrix runs a Lua config, and
#  `hyprctl keyword` refuses to work with a non-legacy parser -- it says so and
#  changes nothing. hl.monitor takes these fields, all confirmed by probing the
#  running compositor (it rejects a field it does not know, which is how the
#  list was established):
#
#      output mode position scale transform vrr bitdepth disabled mirror
#      cm sdrbrightness sdrsaturation supports_wide_color supports_hdr reserved
#
#  State lives outside the repository, in $XDG_STATE_HOME/neobrix/monitors.json.
#  The generated Lua is the one thing written inside it, at hypr/machine/, which
#  is where machine-local Hyprland config already goes and is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
REPO="$(dirname "$HERE")"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/neobrix"
STATE="$STATE_DIR/monitors.json"
PENDING_DIR="${XDG_RUNTIME_DIR:-/tmp}"
PENDING="$PENDING_DIR/neobrix-monitors-pending.json"
# Overridable so the tests can generate into a sandbox instead of the checkout.
GENERATED="${NB_GENERATED:-$REPO/hypr/machine/monitors.lua}"

REVERT_AFTER=0

die() { printf 'neobrix-monitors: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

have python3 || die "python3 not found"

# `monitors all` rather than `monitors`: a disabled output still has to appear in
# the list, or there is no way to switch it back on.
#
# The hyprctl check lives here rather than at the top of the file so that --help
# and anything that only touches the state file still work without a running
# compositor -- which is also what makes the engine testable offline.
raw() {
    have hyprctl || die "hyprctl not found; this needs a running Hyprland"
    hyprctl -j monitors all
}

py() { python3 - "$@"; }

# ── reading ──────────────────────────────────────────────────────────────────

# The saved shape of one output. Deliberately not every field hl.monitor takes:
# these are the ones a person changes, and writing back a field we never show is
# how a layout ends up carrying settings nobody chose.
current_state() {
    NB_MONS="$(raw)" py <<'PY'
import json, os
mons = json.loads(os.environ["NB_MONS"])
def mode_of(m):
    """The advertised mode this output is actually running.

    The reported rate is the real one to three decimals (60.003, 143.981), which
    is not what the mode list calls it and not what hl.monitor should be handed
    back. Snap to the closest advertised mode at the same resolution so a saved
    profile contains a string the hardware recognises.
    """
    want = m.get("refreshRate", 0)
    best, best_d = None, None
    for am in m.get("availableModes") or []:
        try:
            res, _, hz = am.partition("@")
            w, _, h = res.partition("x")
            hz = float(hz.rstrip("Hz"))
            if int(w) != m["width"] or int(h) != m["height"]:
                continue
        except ValueError:
            continue
        d = abs(hz - want)
        if best_d is None or d < best_d:
            best, best_d = (int(w), int(h), hz), d
    if best and best_d is not None and best_d < 1.5:
        return "{}x{}@{:g}".format(best[0], best[1], round(best[2], 2))
    return "{}x{}@{:g}".format(m["width"], m["height"], round(want, 2))

out = {}
for m in mons:
    out[m["name"]] = {
        "mode": mode_of(m),
        "position": "{}x{}".format(m["x"], m["y"]),
        "scale": round(m["scale"], 6),
        "transform": m.get("transform", 0),
        "vrr": 1 if m.get("vrr") else 0,
        "disabled": bool(m.get("disabled", False)),
        "mirror": m.get("mirrorOf") or "none",
    }
print(json.dumps(out, indent=2, sort_keys=True))
PY
}

# Identity of the *set* of outputs, so a layout comes back when the same screens
# do. Description carries make/model/serial; a laptop panel often has an empty
# serial, and two identical external monitors are genuinely indistinguishable by
# anything but the connector they are in, so the connector name is part of the
# key. That means moving the same monitor to a different port is a different
# profile -- correct, since the layout would be different anyway.
fingerprint() {
    NB_MONS="$(raw)" py <<'PY'
import hashlib, json, os
mons = json.loads(os.environ["NB_MONS"])
parts = sorted("{}|{}".format(m["name"], m.get("description") or m["name"]) for m in mons)
print(hashlib.sha1("\n".join(parts).encode()).hexdigest()[:12])
PY
}

outputs_seen() {
    NB_MONS="$(raw)" py <<'PY'
import json, os
mons = json.loads(os.environ["NB_MONS"])
print(", ".join(sorted(m["name"] for m in mons)))
PY
}

cmd_list() {
    NB_MONS="$(raw)" py <<'PY'
import json, os, signal
# Die quietly when the reader goes away, the way any other command does --
# `neobrix-monitors list | head` should not print a traceback.
signal.signal(signal.SIGPIPE, signal.SIG_DFL)
mons = json.loads(os.environ["NB_MONS"])
if not mons:
    print("no outputs")
    raise SystemExit(0)
w = max(len(m["name"]) for m in mons)
for m in sorted(mons, key=lambda m: (m["x"], m["y"])):
    flags = []
    if m.get("disabled"): flags.append("off")
    if m.get("transform"): flags.append("rot{}".format(m["transform"] * 90 % 360))
    if m.get("vrr"): flags.append("vrr")
    if (m.get("mirrorOf") or "none") != "none": flags.append("mirror of " + m["mirrorOf"])
    if m.get("focused"): flags.append("focused")
    print("{name:<{w}}  {ww}x{hh}@{hz:<6.6g} scale {sc:<5.6g} at {x},{y}  {fl}".format(
        name=m["name"], w=w, ww=m["width"], hh=m["height"], hz=round(m["refreshRate"], 2),
        sc=m["scale"], x=m["x"], y=m["y"], fl="  ".join(flags)))
    modes = m.get("availableModes") or []
    if modes:
        print("{pad}  modes: {modes}".format(pad=" " * w, modes=", ".join(modes[:6])
              + (" (+{} more)".format(len(modes) - 6) if len(modes) > 6 else "")))
PY
}

# ── the state file ───────────────────────────────────────────────────────────

read_state() {
    [[ -r $STATE ]] && cat "$STATE" || printf '{"version": 1, "profiles": {}}'
}

write_state() {
    mkdir -p "$STATE_DIR"
    cat > "$STATE.tmp"
    mv "$STATE.tmp" "$STATE"
}

cmd_profiles() {
    NB_STATE="$(read_state)" py <<'PY'
import json, os
st = json.loads(os.environ["NB_STATE"])
profs = st.get("profiles", {})
if not profs:
    print("no saved profiles")
    raise SystemExit(0)
for fp, p in sorted(profs.items(), key=lambda kv: kv[1].get("name", "")):
    print("{}  [{}]".format(p.get("name", "(unnamed)"), fp))
    print("     outputs: {}".format(p.get("outputs_seen", "?")))
    for name, o in sorted(p.get("outputs", {}).items()):
        print("       {:<12} {} scale {} at {}{}".format(
            name, o.get("mode", "?"), o.get("scale", "?"), o.get("position", "?"),
            "  (off)" if o.get("disabled") else ""))
PY
}

cmd_save() {
    local name="${1:-}" fp; fp="$(fingerprint)"
    [[ -n $name ]] || name="$(outputs_seen)"
    NB_STATE="$(read_state)" NB_FP="$fp" NB_NAME="$name" NB_SEEN="$(outputs_seen)" \
        NB_OUTPUTS="$(current_state)" py <<'PY' | write_state
import json, os
st = json.loads(os.environ["NB_STATE"])
st.setdefault("version", 1)
st.setdefault("profiles", {})
st["profiles"][os.environ["NB_FP"]] = {
    "name": os.environ["NB_NAME"],
    "outputs_seen": os.environ["NB_SEEN"],
    "outputs": json.loads(os.environ["NB_OUTPUTS"]),
}
print(json.dumps(st, indent=2, sort_keys=True))
PY
    printf 'saved "%s" for %s [%s]\n' "$name" "$(outputs_seen)" "$fp"
}

cmd_forget() {
    local name="${1:?a profile name or fingerprint}"
    NB_STATE="$(read_state)" NB_WANT="$name" py <<'PY' | write_state
import json, os, sys
st = json.loads(os.environ["NB_STATE"])
want = os.environ["NB_WANT"]
profs = st.get("profiles", {})
gone = [fp for fp, p in profs.items() if fp == want or p.get("name") == want]
for fp in gone:
    del profs[fp]
if not gone:
    sys.stderr.write("neobrix-monitors: no profile matched %r\n" % want)
print(json.dumps(st, indent=2, sort_keys=True))
PY
}

# ── applying ────────────────────────────────────────────────────────────────

# One hl.monitor call per output. Position is always explicit: "auto" re-places
# outputs, which silently rearranges a desk someone has already arranged.
apply_json() {
    local json="$1"
    local specs; specs="$(NB_JSON="$json" py <<'PY'
import json, os
outs = json.loads(os.environ["NB_JSON"])
for name, o in sorted(outs.items()):
    fields = ['output="%s"' % name]
    if o.get("disabled"):
        # Everything else is meaningless while it is off, and passing a mode an
        # unplugged output cannot do is a good way to get an error instead of a
        # disable.
        fields.append("disabled=true")
    else:
        fields.append('mode="%s"' % o.get("mode", "preferred"))
        fields.append('position="%s"' % o.get("position", "auto"))
        fields.append("scale=%s" % o.get("scale", 1))
        fields.append("transform=%d" % int(o.get("transform", 0)))
        fields.append("vrr=%d" % int(o.get("vrr", 0)))
        fields.append("disabled=false")
        mirror = o.get("mirror") or "none"
        fields.append('mirror="%s"' % mirror)
    print("hl.monitor({%s})" % ", ".join(fields))
PY
)"
    local failed=0 spec
    while IFS= read -r spec; do
        [[ -n $spec ]] || continue
        local out; out="$(hyprctl eval "$spec" 2>&1 | head -1)"
        if [[ $out != ok ]]; then
            printf 'neobrix-monitors: %s\n  %s\n' "$out" "$spec" >&2
            failed=1
        fi
    done <<< "$specs"
    return "$failed"
}

# A detached watcher, so a change that blacks out the screen comes back even if
# whatever asked for it is gone. It re-applies the snapshot itself rather than
# calling back into this script, so it cannot be defeated by the script being
# mid-edit or off PATH.
schedule_revert() {
    local seconds="$1"
    setsid bash -c '
        sleep "$1"
        [[ -r "$2" ]] || exit 0
        json="$(cat "$2")"
        rm -f "$2"
        while IFS= read -r spec; do
            [[ -n $spec ]] && hyprctl eval "$spec" >/dev/null 2>&1
        done < <(NB_JSON="$json" python3 -c "
import json, os
outs = json.loads(os.environ[\"NB_JSON\"])
for name, o in sorted(outs.items()):
    if o.get(\"disabled\"):
        print(\"hl.monitor({output=\\\"%s\\\", disabled=true})\" % name)
    else:
        print(\"hl.monitor({output=\\\"%s\\\", mode=\\\"%s\\\", position=\\\"%s\\\", scale=%s, transform=%d, vrr=%d, disabled=false, mirror=\\\"%s\\\"})\" % (
            name, o.get(\"mode\", \"preferred\"), o.get(\"position\", \"auto\"), o.get(\"scale\", 1),
            int(o.get(\"transform\", 0)), int(o.get(\"vrr\", 0)), o.get(\"mirror\") or \"none\"))
")
    ' _ "$seconds" "$PENDING" >/dev/null 2>&1 < /dev/null &
    disown 2>/dev/null || true
}

begin_pending() {
    (( REVERT_AFTER > 0 )) || return 0
    current_state > "$PENDING"
    schedule_revert "$REVERT_AFTER"
}

cmd_confirm() {
    if [[ -e $PENDING ]]; then rm -f "$PENDING"; echo "kept"; else echo "nothing pending"; fi
}

cmd_revert() {
    [[ -r $PENDING ]] || { echo "nothing pending"; return 0; }
    local json; json="$(cat "$PENDING")"
    rm -f "$PENDING"
    apply_json "$json" || true
    echo "reverted"
}

cmd_set() {
    local output="${1:?an output name}"; shift
    (( $# )) || die "nothing to set; try mode=1920x1080@60 or scale=1.25"

    local merged
    merged="$(NB_CUR="$(current_state)" NB_OUT="$output" NB_KV="$*" py <<'PY'
import json, os, sys
outs = json.loads(os.environ["NB_CUR"])
name = os.environ["NB_OUT"]
if name not in outs:
    sys.stderr.write("neobrix-monitors: no output named %r\n" % name)
    raise SystemExit(1)
o = outs[name]
for pair in os.environ["NB_KV"].split():
    if "=" not in pair:
        sys.stderr.write("neobrix-monitors: expected key=value, got %r\n" % pair)
        raise SystemExit(1)
    k, v = pair.split("=", 1)
    if k not in ("mode", "position", "scale", "transform", "vrr", "disabled", "mirror"):
        sys.stderr.write("neobrix-monitors: cannot set %r\n" % k)
        raise SystemExit(1)
    if k in ("transform", "vrr"):
        v = int(v)
    elif k == "scale":
        v = float(v)
    elif k == "disabled":
        v = v.lower() in ("1", "true", "yes", "on")
    o[k] = v
# Only the output being changed is re-applied. Re-applying the others would
# undo a change someone made outside this tool between the read and the write.
print(json.dumps({name: o}, indent=2, sort_keys=True))
PY
)" || exit 1

    begin_pending
    apply_json "$merged"
}

cmd_apply() {
    local want="${1:-}"
    local fp; fp="$(fingerprint)"
    local outputs
    outputs="$(NB_STATE="$(read_state)" NB_FP="$fp" NB_WANT="$want" py <<'PY'
import json, os, sys
st = json.loads(os.environ["NB_STATE"])
profs = st.get("profiles", {})
want = os.environ["NB_WANT"]
if want:
    for fp, p in profs.items():
        if fp == want or p.get("name") == want:
            print(json.dumps(p.get("outputs", {})))
            raise SystemExit(0)
    sys.stderr.write("neobrix-monitors: no profile matched %r\n" % want)
    raise SystemExit(1)
p = profs.get(os.environ["NB_FP"])
if not p:
    sys.stderr.write("neobrix-monitors: no profile saved for this set of outputs\n")
    raise SystemExit(2)
print(json.dumps(p.get("outputs", {})))
PY
)" || exit $?

    begin_pending
    apply_json "$outputs"
}

# ── arranging ────────────────────────────────────────────────────────────────
#
# Rotating a screen changes how much room it takes: a 2560x1440 panel turned on
# its side is 1440 wide, not 2560. Hyprland keeps reporting the mode unrotated,
# so a layout built before the rotation leaves a gap exactly as wide as the
# difference -- and a gap is dead space the pointer cannot cross, which reads as
# "the screens are next to each other but the cursor will not go there".
#
# `arrange` closes that: it packs the enabled outputs left to right in the order
# they are already in, using each one's real footprint, and leaves the vertical
# positions alone.
cmd_arrange() {
    local packed
    packed="$(NB_MONS="$(raw)" py <<'PY'
import json, os

mons = [m for m in json.loads(os.environ["NB_MONS"]) if not m.get("disabled")]

def footprint(m):
    """Logical size, which is the mode turned on its side for a quarter turn."""
    scale = m.get("scale") or 1
    w, h = m["width"], m["height"]
    if (m.get("transform") or 0) % 2 == 1:
        w, h = h, w
    return round(w / scale), round(h / scale)

mons.sort(key=lambda m: (m["x"], m["y"]))
out, x = {}, None
for m in mons:
    w, h = footprint(m)
    if x is None:
        x = m["x"]          # the leftmost screen stays where it is
    out[m["name"]] = {
        "mode": "{}x{}@{:g}".format(m["width"], m["height"], round(m["refreshRate"], 2)),
        "position": "{}x{}".format(x, m["y"]),
        "scale": round(m.get("scale") or 1, 6),
        "transform": m.get("transform") or 0,
        "vrr": 1 if m.get("vrr") else 0,
        "disabled": False,
        "mirror": m.get("mirrorOf") or "none",
    }
    x += w
print(json.dumps(out, indent=2, sort_keys=True))
PY
)"
    begin_pending
    apply_json "$packed"
    printf 'packed %s screen(s) edge to edge\n' "$(printf '%s' "$packed" | grep -c '"mode"')"
}

# ── refresh cap ──────────────────────────────────────────────────────────────
#
# The battery policy wants the internal panel slower, and the saved profile
# wants it as the person chose. Both cannot own the mode, so the cap is layered
# on top: `cap` remembers what the panel was running and drops it to the fastest
# advertised mode at or below the limit, `uncap` puts it back. Only outputs named
# eDP* are touched -- an external monitor is somebody's desk, not a battery
# saving.
internal_outputs() {
    NB_MONS="$(raw)" py <<'PY'
import json, os
for m in json.loads(os.environ["NB_MONS"]):
    if m["name"].startswith("eDP") and not m.get("disabled"):
        print(m["name"])
PY
}

cmd_cap() {
    local hz="${1:?a refresh rate}"
    local restore_dir="$STATE_DIR"; mkdir -p "$restore_dir"
    local out
    while IFS= read -r out; do
        [[ -n $out ]] || continue
        local target
        target="$(NB_MONS="$(raw)" NB_OUT="$out" NB_HZ="$hz" py <<'PY'
import json, os
name, cap = os.environ["NB_OUT"], float(os.environ["NB_HZ"])
for m in json.loads(os.environ["NB_MONS"]):
    if m["name"] != name:
        continue
    best = None
    for am in m.get("availableModes") or []:
        res, _, hz = am.partition("@")
        w, _, h = res.partition("x")
        try:
            hz = float(hz.rstrip("Hz"))
            if int(w) != m["width"] or int(h) != m["height"]:
                continue
        except ValueError:
            continue
        # Fastest mode that still respects the cap; if nothing is slow enough,
        # the panel simply has no lower gear and is left alone.
        if hz <= cap + 0.5 and (best is None or hz > best):
            best = hz
    if best is not None:
        print("{}x{}@{:g}".format(m["width"], m["height"], round(best, 2)))
PY
)"
        [[ -n $target ]] || continue
        # Remember the mode in force before the cap, so uncapping restores what
        # was actually there rather than guessing at the fastest.
        NB_CUR="$(current_state)" NB_OUT="$out" py <<'PY' > "$restore_dir/refresh-restore-$out"
import json, os
print(json.loads(os.environ["NB_CUR"])[os.environ["NB_OUT"]]["mode"])
PY
        apply_json "$(printf '{"%s": {"mode": "%s", "position": "%s", "scale": %s}}' \
            "$out" "$target" \
            "$(NB_CUR="$(current_state)" NB_OUT="$out" py <<'PY'
import json, os
print(json.loads(os.environ["NB_CUR"])[os.environ["NB_OUT"]]["position"])
PY
)" \
            "$(NB_CUR="$(current_state)" NB_OUT="$out" py <<'PY'
import json, os
print(json.loads(os.environ["NB_CUR"])[os.environ["NB_OUT"]]["scale"])
PY
)")"
        printf 'capped %s at %s\n' "$out" "$target"
    done < <(internal_outputs)
}

cmd_uncap() {
    local out
    while IFS= read -r out; do
        [[ -n $out ]] || continue
        local f="$STATE_DIR/refresh-restore-$out" mode=""
        [[ -r $f ]] && mode="$(cat "$f")"
        # Nothing remembered means nothing was capped; "preferred" is what the
        # config would have chosen anyway.
        [[ -n $mode ]] || mode="preferred"
        apply_json "$(printf '{"%s": {"mode": "%s", "position": "%s", "scale": %s}}' \
            "$out" "$mode" \
            "$(NB_CUR="$(current_state)" NB_OUT="$out" py <<'PY'
import json, os
print(json.loads(os.environ["NB_CUR"])[os.environ["NB_OUT"]]["position"])
PY
)" \
            "$(NB_CUR="$(current_state)" NB_OUT="$out" py <<'PY'
import json, os
print(json.loads(os.environ["NB_CUR"])[os.environ["NB_OUT"]]["scale"])
PY
)")"
        rm -f "$f"
        printf 'uncapped %s to %s\n' "$out" "$mode"
    done < <(internal_outputs)
}

# ── the startup path ─────────────────────────────────────────────────────────
#
# Applying from the shell after login works, but the layout visibly snaps into
# place a second late. Emitting Lua that Hyprland reads while parsing its config
# means the session starts in the right shape. The catch-all comes first so an
# output with no saved settings still gets something sensible.
cmd_generate() {
    local fp; fp="$(fingerprint)"
    mkdir -p "$(dirname "$GENERATED")"
    NB_STATE="$(read_state)" NB_FP="$fp" py <<'PY' > "$GENERATED.tmp"
import json, os
st = json.loads(os.environ["NB_STATE"])
profs = st.get("profiles", {})
print("-- Generated by neobrix-monitors. Edits here are overwritten; change the")
print("-- layout from the control centre's Displays tab, or with neobrix-monitors.")
print("return function(_ctx)")
print('    hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })')
for fp, p in sorted(profs.items(), key=lambda kv: kv[1].get("name", "")):
    print()
    print("    -- %s (%s)" % (p.get("name", "unnamed"), p.get("outputs_seen", "?")))
    for name, o in sorted(p.get("outputs", {}).items()):
        if o.get("disabled"):
            print('    hl.monitor({ output = "%s", disabled = true })' % name)
        else:
            print('    hl.monitor({ output = "%s", mode = "%s", position = "%s", scale = %s,'
                  ' transform = %d, vrr = %d, disabled = false, mirror = "%s" })' % (
                  name, o.get("mode", "preferred"), o.get("position", "auto"),
                  o.get("scale", 1), int(o.get("transform", 0)), int(o.get("vrr", 0)),
                  o.get("mirror") or "none"))
print("end")
PY
    mv "$GENERATED.tmp" "$GENERATED"
    printf 'wrote %s\n' "$GENERATED"
}

# ── dispatch ────────────────────────────────────────────────────────────────

ARGS=()
while (( $# )); do
    case $1 in
        --revert-after) REVERT_AFTER="${2:?seconds}"; shift 2 ;;
        --revert-after=*) REVERT_AFTER="${1#*=}"; shift ;;
        *) ARGS+=("$1"); shift ;;
    esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

case "${1:-list}" in
    list)        cmd_list ;;
    state)       current_state ;;
    fingerprint) printf '%s  (%s)\n' "$(fingerprint)" "$(outputs_seen)" ;;
    set)         shift; cmd_set "$@" ;;
    apply)       shift; cmd_apply "${1:-}" ;;
    save)        shift; cmd_save "${1:-}" ;;
    profiles)    cmd_profiles ;;
    forget)      shift; cmd_forget "${1:-}" ;;
    confirm)     cmd_confirm ;;
    revert)      cmd_revert ;;
    generate)    cmd_generate ;;
    arrange)     cmd_arrange ;;
    cap)         shift; cmd_cap "${1:-}" ;;
    uncap)       cmd_uncap ;;
    -h|--help|help) sed -n '2,40p' "$(readlink -f "$0")" | sed 's/^# \?//' ;;
    *)           die "unknown command '$1'; try --help" ;;
esac
