#!/usr/bin/env bash
# Generate a NeoBrix theme for every vault registered in the local Obsidian app.
#
# Obsidian keeps appearance settings inside each vault.  The theme therefore
# lives at <vault>/.obsidian/themes/neobrix rather than in ~/.config/obsidian,
# and is generated for every vault Obsidian knows about.  It deliberately
# carries the currently active NeoBrix palette in both Obsidian base-scheme
# selectors. Obsidian 1.13 on Linux does not reliably observe a live portal
# scheme switch, while it does reload its active theme stylesheet; generating on
# each NeoBrix switch keeps it in lockstep without restarting the note app.

set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
THUMBNAIL="$HERE/../docs/identity/obsidian-theme-thumbnail.png"
# shellcheck source=lib/palette.sh
source "$HERE/lib/palette.sh"

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
MODE="${1:-dawn}"
[[ "$MODE" == "dawn" || "$MODE" == "dusk" ]] || {
    echo "usage: neobrix-generate-obsidian-theme [dawn|dusk]" >&2
    exit 2
}
REGISTRY="$CFG/obsidian/obsidian.json"
[[ -f "$REGISTRY" ]] || exit 0

mapfile -t VAULTS < <(python3 - "$REGISTRY" <<'PY'
import json, pathlib, sys
try:
    vaults = json.loads(pathlib.Path(sys.argv[1]).read_text()).get("vaults", {})
except Exception:
    vaults = {}
for item in vaults.values():
    path = item.get("path") if isinstance(item, dict) else None
    if isinstance(path, str) and path:
        print(path)
PY
)

(( ${#VAULTS[@]} )) || exit 0

emit_vars() {
    local mode="$1"
    neobrix_palette "$mode"
    cat <<EOF
  --background-primary: #$BG;
  --background-primary-alt: #$BG_DEEP;
  --background-secondary: #$SURFACE_ALT;
  --background-secondary-alt: #$BG_DEEP;
  --background-modifier-border: #$FG_DIM;
  --background-modifier-border-focus: #$PRIMARY;
  --background-modifier-border-hover: #$FG_DIM;
  --background-modifier-hover: #$BG_DEEP;
  --background-modifier-active-hover: #$PRIMARY;
  --background-modifier-success: #$SUCCESS;
  --background-modifier-error: #$ERROR;
  --background-modifier-error-hover: #$ERROR;
  --text-normal: #$FG;
  --text-muted: #$FG_DIM;
  --text-faint: #$FG_DIM;
  --text-accent: #$INFO;
  --text-accent-hover: #$PRIMARY;
  --text-on-accent: #$ON_ACCENT;
  --interactive-normal: #$BG;
  --interactive-hover: #$BG_DEEP;
  --interactive-accent: #$PRIMARY;
  --interactive-accent-hover: #$PINK;
  --scrollbar-thumb-bg: #$FG_DIM;
  --scrollbar-active-thumb-bg: #$PRIMARY;
  --scrollbar-bg: transparent;
  --code-background: #$BG_DEEP;
  --code-normal: #$FG;
  --code-comment: #$FG_DIM;
  --code-function: #$INFO;
  --code-keyword: #$PINK;
  --code-string: #$SECONDARY;
  --code-value: #$TERTIARY;
  --code-tag: #$ERROR;
  --code-property: #$WARNING;
  --callout-border-width: 3px;
  --callout-radius: 7px;
  --radius-s: 4px;
  --radius-m: 7px;
  --radius-l: 10px;
  --tab-radius-active: 7px;
  --tab-outline-width: 1px;
  --tab-divider-color: #$FG_DIM;
  --tab-container-background: #$SURFACE_ALT;
  --tab-background-active: #$BG;
  --tab-text-color: #$FG_DIM;
  --tab-text-color-focused: #$FG;
  --tab-text-color-focused-active: #$FG;
  --titlebar-background: #$SURFACE_ALT;
  --titlebar-background-focused: #$SURFACE_ALT;
  --titlebar-text-color: #$FG_DIM;
  --titlebar-text-color-focused: #$FG;
  --ribbon-background: #$SURFACE_ALT;
  --nav-item-background-hover: #$BG_DEEP;
  --nav-item-background-active: #$PRIMARY;
  --nav-item-color: #$FG;
  --nav-item-color-hover: #$FG;
  --nav-item-color-active: #$ON_ACCENT;
  --modal-background: #$BG;
  --modal-border-color: #$FG_DIM;
  --prompt-border-color: #$FG_DIM;
  --prompt-input-background: #$BG_DEEP;
  --prompt-input-border-color: #$OUTLINE;
  --graph-line: #$FG_DIM;
  --graph-node: #$PRIMARY;
  --graph-node-tag: #$TERTIARY;
  --graph-node-attachment: #$SECONDARY;
  --blockquote-border-color: #$PRIMARY;
  --blockquote-background-color: #$SURFACE_ALT;
EOF
}

THEME_CSS="$(mktemp)"
trap 'rm -f "$THEME_CSS"' EXIT
{
    cat <<'EOF'
/* Generated by NeoBrix. Edit scripts/neobrix-generate-obsidian-theme, not this file. */

.theme-light {
EOF
    emit_vars "$MODE"
    cat <<'EOF'
}

.theme-dark {
EOF
    emit_vars "$MODE"
    cat <<'EOF'
}

/* Keep the shell calm: Obsidian has many nested panes, so hard borders on each
   one turn a notebook into a grid. Accent marks the current tab instead. */
.workspace-tab-header.is-active {
  box-shadow: inset 0 -3px 0 var(--interactive-accent);
}

.nav-file-title.is-active,
.nav-folder-title.is-active,
.suggestion-item.is-selected,
.menu-item.is-selected {
  color: var(--text-on-accent);
}

.cm-s-obsidian span.cm-formatting-link,
.cm-s-obsidian span.cm-link {
  color: var(--text-accent);
}

.callout {
  border: var(--callout-border-width) solid rgb(var(--callout-color));
  box-shadow: 3px 3px 0 var(--background-modifier-border);
}

.markdown-rendered blockquote {
  border-right: 1px solid var(--background-modifier-border);
  padding: var(--size-4-2) var(--size-4-3);
}
EOF
} > "$THEME_CSS"

for vault in "${VAULTS[@]}"; do
    [[ -d "$vault/.obsidian" ]] || continue
    themes_dir="$vault/.obsidian/themes"
    # Obsidian requires the folder and manifest name to match exactly. Migrate
    # the early generated lowercase directory instead of leaving two copies.
    old_theme_dir="$themes_dir/neobrix"
    theme_dir="$themes_dir/NeoBrix"
    if [[ -d "$old_theme_dir" && ! -e "$theme_dir" ]] \
       && grep -q '^/\* Generated by NeoBrix\.' "$old_theme_dir/theme.css" 2>/dev/null; then
        mv "$old_theme_dir" "$theme_dir"
    fi
    install -d -m 755 "$theme_dir"
    install -m 644 "$THEME_CSS" "$theme_dir/theme.css"
    [[ -r "$THUMBNAIL" ]] && install -m 644 "$THUMBNAIL" "$theme_dir/screenshot.png"
    cat > "$theme_dir/manifest.json" <<'EOF'
{
  "name": "NeoBrix",
  "version": "1.0.0",
  "minAppVersion": "1.13.0",
  "author": "NeoBrix",
  "authorUrl": "https://github.com/asad-albadi/NeoBrix"
}
EOF

    # Select the generated theme while preserving every other vault appearance
    # preference. Obsidian watches this file and applies the theme after a reload.
    python3 - "$vault/.obsidian/appearance.json" <<'PY'
import json, os, pathlib, sys
path = pathlib.Path(sys.argv[1])
try:
    data = json.loads(path.read_text()) if path.exists() else {}
except Exception:
    data = {}
if not isinstance(data, dict):
    data = {}
data["theme"] = "NeoBrix"
tmp = path.with_suffix(".tmp")
tmp.write_text(json.dumps(data, indent=2) + "\n")
os.replace(tmp, path)
PY
    printf 'themed Obsidian vault: %s\n' "$vault"
done
