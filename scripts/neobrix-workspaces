#!/usr/bin/env python3
"""Per-monitor workspace mapping for NeoBrix.

Hyprland workspace IDs are global. This keeps a stable, private ID range for
each physical output and presents the same local 1..N set on every display.
"""
import argparse, fcntl, json, os, subprocess
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home()/".local/state")) / "neobrix/workspaces.json"

def load():
    try: return json.loads(STATE.read_text())
    except Exception: return {"enabled": False, "spaces": 5, "slots": {}}
def save(data):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temp = STATE.with_suffix(".tmp")
    temp.write_text(json.dumps(data, separators=(",", ":")) + "\n")
    os.chmod(temp, 0o600); temp.replace(STATE)
def hypr(*args):
    return subprocess.run(["hyprctl", *args], text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL).stdout
def hypr_json(*args):
    try: return json.loads(hypr("-j", *args))
    except Exception: return []
def monitors():
    try: data = json.loads(hypr("-j", "monitors"))
    except Exception: data = []
    data.sort(key=lambda m: (m.get("x", 0), m.get("y", 0), m.get("name", "")))
    return data
def key(m):
    # Base EDID identity: serials survive connector changes through docks.
    # monitor_entries qualifies it when missing or duplicate metadata is ambiguous.
    parts = [str(m.get(k, "")) for k in ("make", "model", "serial", "description")]
    return "|".join(parts) if any(parts) else m.get("name", "")
def monitor_entries(data):
    """Disambiguate outputs whose EDID does not provide a unique identity.

    Keep serial-bearing identities portable across docks. For anonymous or
    duplicate EDIDs, remember the connector as well; two identical panels must
    never share a workspace range. Migrate the old metadata-only assignment
    once, rather than reserving its slot alongside the new connector key.
    """
    raw = monitors()
    slots = data.setdefault("slots", {})
    connectors = data.setdefault("connectors", {})
    groups = {}
    for m in raw:
        groups.setdefault(key(m), []).append(m)
    identities = {}
    for base, group in groups.items():
        prefix = base + "|output:"
        qualified = (base != group[0]["name"] and not group[0].get("serial")) or len(group) > 1 \
            or any(saved.startswith(prefix) for saved in slots)
        if qualified and base in slots:
            # A newly connected identical panel must not inherit the original
            # panel's range just because its connector sorts first. Remember
            # the connector while an EDID is unique. Legacy state has no owner;
            # its best available fallback is the physical left-to-right order.
            owner = next((m for m in group if m["name"] == connectors.get(base)), group[0])
            identity = prefix + owner["name"]
            slots.setdefault(identity, slots.pop(base))
        if len(group) == 1:
            connectors[base] = group[0]["name"]
        for m in group:
            identities[m["name"]] = prefix + m["name"] if qualified else base
    return [(m, identities[m["name"]]) for m in raw]

def mapping(data):
    slots = data.setdefault("slots", {})
    entries = monitor_entries(data)
    used = set(slots.values())
    result = []
    for m, k in entries:
        if k not in slots:
            n = 0
            while n in used: n += 1
            slots[k] = n; used.add(n)
        result.append({"name": m["name"], "id": m.get("id"), "slot": slots[k],
                       "focused": bool(m.get("focused"))})
    return result
def compact_connected_slots(data):
    """Give the currently connected outputs contiguous ranges and move clients.

    Saved monitor identities intentionally survive unplugging, but their old
    slot numbers must not reserve holes forever.  Without this compaction the
    third currently connected display can inherit slot 4 from a past dock and
    receive 21..25 when five local workspaces were requested.
    """
    owners = mapping(data)
    targets = {owner["id"]: index for index, owner in enumerate(owners)}
    if all(owner["slot"] == targets[owner["id"]] for owner in owners):
        return False

    spaces = int(data["spaces"])
    changes = []
    for client in hypr_json("clients"):
        owner = next((candidate for candidate in owners if candidate["id"] == client.get("monitor")), None)
        workspace = client.get("workspace", {}).get("id")
        address = client.get("address")
        if not owner or client.get("pinned") or not isinstance(workspace, int) or workspace < 1 or not address:
            continue
        local = workspace - owner["slot"] * spaces
        target = targets[owner["id"]] * spaces + (local if 1 <= local <= spaces else 1)
        if target != workspace:
            changes.append((address, target, owner["name"]))

    # Move every client before placing destination workspaces.  This makes
    # swaps safe: a target ID may currently belong to another monitor's old
    # range, but the destination is owned correctly once all clients arrive.
    for address, target, _ in changes:
        move_named_window(address, target)
    placed = set()
    for _, target, monitor in changes:
        if (target, monitor) not in placed:
            move_workspace(target, monitor)
            placed.add((target, monitor))

    slots = data.setdefault("slots", {})
    for raw, identity in monitor_entries(data):
        if raw.get("id") in targets:
            slots[identity] = targets[raw["id"]]
    return True
def workspace_id(data, monitor, local):
    for m in mapping(data):
        if m["name"] == monitor: return m["slot"] * int(data["spaces"]) + local
    return local
def active_monitor(data):
    for m in mapping(data):
        if m["focused"]: return m["name"]
    return mapping(data)[0]["name"] if mapping(data) else ""
def dispatch(expr):
    # NeoBrix uses Hyprland's Lua configuration API.  In that mode the legacy
    # `hyprctl dispatch workspace 3` form is parsed as Lua and rejected; route
    # every workspace action through the native dispatcher instead.
    hypr("eval", "hl.dispatch(" + expr + ")")

def focus_workspace(workspace):
    dispatch("hl.dsp.focus({ workspace = " + json.dumps(workspace) + " })")

def requested_monitor(data, args):
    name = getattr(args, "monitor", None) or active_monitor(data)
    if not any(m["name"] == name for m in mapping(data)):
        raise ValueError("monitor is not connected: " + name)
    return name

def focus_local_workspace(data, monitor, workspace):
    # Workspace IDs are global, including empty persistent workspaces. A bar
    # click must not follow a stale ID onto another output. Preserve ordinary
    # windows on their physical display before reclaiming a foreign ID.
    existing = next((w for w in hypr_json("workspaces") if w.get("id") == workspace), None)
    if existing and existing.get("monitor") != monitor:
        if existing.get("windows", 0):
            migrate_on_enable(data)
        move_workspace(workspace, monitor)
    # New workspaces are created on the focused monitor. Layer-shell clicks
    # alone do not reliably change Hyprland's monitor focus.
    dispatch("hl.dsp.focus({ monitor = " + json.dumps(monitor) + " })")
    focus_workspace(workspace)

def move_window(workspace):
    dispatch("hl.dsp.window.move({ workspace = " + json.dumps(workspace) + ", silent = true })")

def move_named_window(address, workspace):
    dispatch("hl.dsp.window.move({ window = " + json.dumps("address:" + address) +
             ", workspace = " + json.dumps(workspace) + ", silent = true })")

def move_workspace(workspace, monitor):
    dispatch("hl.dsp.workspace.move({ workspace = " + json.dumps(workspace) +
             ", monitor = " + json.dumps(monitor) + " })")

def reconcile_slots(data):
    """Repair a saved display-to-range assignment from visible windows.

    A dock can make outputs appear in a different order than the one in which
    their slots were first saved.  On the first enable, infer an unambiguous
    existing layout from client workspace IDs rather than showing every window
    as if it belonged to the other display.
    """
    owners = mapping(data)
    candidates = [m["slot"] for m in owners]
    clients = hypr_json("clients")
    proposed = {}
    for owner in owners:
        ids = [c.get("workspace", {}).get("id") for c in clients
               if c.get("monitor") == owner["id"]]
        scores = {slot: sum(slot * int(data["spaces"]) < wid <= (slot + 1) * int(data["spaces"])
                             for wid in ids if isinstance(wid, int))
                  for slot in candidates}
        best = max(candidates, key=lambda slot: scores[slot])
        # Never guess from an empty display or a tie.  Keeping the saved slot
        # is safer than moving the indicator range without evidence.
        if scores[best] > scores[owner["slot"]] and list(scores.values()).count(scores[best]) == 1:
            proposed[owner["id"]] = best

    final = {m["id"]: proposed.get(m["id"], m["slot"]) for m in owners}
    if len(set(final.values())) != len(final):
        return
    slots = data.setdefault("slots", {})
    for raw, identity in monitor_entries(data):
        if raw.get("id") in final:
            slots[identity] = final[raw["id"]]

def migrate_on_enable(data):
    """Put every ordinary window in the active display's local ID range.

    The mode may be enabled after a normal Hyprland session, or after docking
    to displays whose saved slots were created much earlier.  In either case a
    window can be on an ID which the per-monitor bar does not represent.  Keep
    a local number already in the display's range; otherwise collect it into
    that display's local workspace 1.
    """
    spaces = int(data["spaces"])
    owners = {m["id"]: m for m in mapping(data)}
    changes = []
    for client in hypr_json("clients"):
        owner = owners.get(client.get("monitor"))
        workspace = client.get("workspace", {}).get("id")
        address = client.get("address")
        if not owner or client.get("pinned") or not isinstance(workspace, int) or workspace < 1 or not address:
            continue
        local = workspace - owner["slot"] * spaces
        target = workspace if 1 <= local <= spaces else owner["slot"] * spaces + 1
        if target != workspace:
            changes.append((address, target, owner["name"]))

    # A window move creates a missing destination.  Place the resulting
    # workspace on its owner afterwards, including when its numerical ID used
    # to belong to a disconnected display's old range.
    for address, target, _ in changes:
        move_named_window(address, target)
    for _, target, monitor in {(a, t, m) for a, t, m in changes}:
        move_workspace(target, monitor)

def migrate_spaces(data, old_spaces, new_spaces):
    """Preserve each monitor's local workspaces across an ID-layout change.

    The global ID ranges are based on the workspace count.  For example, when
    changing from five to three spaces, monitor slot 1 changes from 6..10 to
    4..6.  Simply saving the new number would make its old local workspace 1
    appear as local workspace 3, and strand local workspaces 4 and 5.  Move
    every client deliberately: retained local numbers follow their new ID;
    removed local numbers collapse into local workspace 1.
    """
    owners = {m["id"]: m for m in mapping(data)}
    changes = []
    for client in hypr_json("clients"):
        owner = owners.get(client.get("monitor"))
        workspace = client.get("workspace", {}).get("id")
        address = client.get("address")
        if not owner or client.get("pinned") or not isinstance(workspace, int) or not address:
            continue
        local = workspace - owner["slot"] * old_spaces
        if local < 1 or local > old_spaces:
            continue
        retained = local if local <= new_spaces else 1
        target = owner["slot"] * new_spaces + retained
        if target != workspace:
            changes.append((address, target, owner["name"]))

    # Moving a window creates a missing destination workspace.  Only then can
    # Hyprland move that workspace to its new owner.  A destination may also
    # currently belong to a different slot's old range, in which case this
    # final placement makes its ownership unambiguous.
    for address, target, _ in changes:
        move_named_window(address, target)
    for _, target, monitor in {(a, t, m) for a, t, m in changes}:
        move_workspace(target, monitor)

def execute(a):
    data = load()
    topology_changed = False
    if data.get("enabled") and (a.cmd != "enabled" or bool(a.value)):
        topology_changed = compact_connected_slots(data)
    else:
        mapping(data)
    if a.cmd == "enabled":
        if bool(a.value) and not data.get("enabled"):
            data["enabled"] = True
            reconcile_slots(data)
            topology_changed = compact_connected_slots(data) or topology_changed
            migrate_on_enable(data)
        data["enabled"] = bool(a.value); save(data)
    elif a.cmd == "spaces":
        old_spaces = int(data.get("spaces", 5))
        new_spaces = max(3, min(10, a.value))
        if data.get("enabled") and new_spaces != old_spaces:
            migrate_spaces(data, old_spaces, new_spaces)
        data["spaces"] = new_spaces; save(data)
    elif a.cmd in ("focus", "move"):
        local = max(1, min(int(data["spaces"]) if data.get("enabled") else 10, a.value))
        if not data.get("enabled"):
            if a.cmd == "focus": focus_workspace(local)
            else: move_window(local)
        else:
            mon = requested_monitor(data, a); wid = workspace_id(data, mon, local)
            if a.cmd == "focus": focus_local_workspace(data, mon, wid)
            else: move_window(wid)
    elif a.cmd == "cycle":
        if not data.get("enabled"):
            focus_workspace("e+1" if a.value > 0 else "e-1")
        else:
            mon = requested_monitor(data, a); ids = [workspace_id(data, mon, i) for i in range(1, int(data["spaces"]) + 1)]
            current = next((m.get("activeWorkspace", {}).get("id") for m in monitors() if m["name"] == mon), None)
            index = ids.index(current) if current in ids else 0
            wid = ids[(index + (1 if a.value > 0 else -1)) % len(ids)]
            focus_local_workspace(data, mon, wid)
    if a.cmd in ("show", "map"):
        # Startup and monitor events request this probe. Reconcile under the
        # same lock as settings changes, including the initial state read.
        if a.cmd == "show" and data.get("enabled"):
            migrate_on_enable(data)
            save(data)
        out = {"enabled": bool(data.get("enabled")), "spaces": int(data.get("spaces", 5)), "monitors": mapping(data)}
        for m in out["monitors"]: m["ids"] = [m["slot"] * out["spaces"] + i for i in range(1, out["spaces"] + 1)]
        print(json.dumps(out, separators=(",", ":")))
    elif topology_changed:
        save(data)

def main(argv=None):
    p = argparse.ArgumentParser(); sub = p.add_subparsers(dest="cmd")
    sub.add_parser("show"); sub.add_parser("map")
    for name in ("enabled", "spaces", "focus", "move", "cycle"):
        q = sub.add_parser(name); q.add_argument("value", type=int)
        if name in ("focus", "cycle"):
            q.add_argument("--monitor", help="output receiving the action (defaults to focused output)")
    args = p.parse_args(argv)
    # A separate, stable inode: save() replaces the state file atomically.
    # Lock before load(), and hold it through migration and save, so shell
    # probes, settings changes and keybindings cannot use stale assignments
    # or share the temporary state file concurrently. Closing releases it.
    STATE.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(STATE.with_suffix(".lock"), os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(fd, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            execute(args)
        except ValueError as error:
            p.exit(1, str(error) + "\n")

if __name__ == "__main__":
    main()
