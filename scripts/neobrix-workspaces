#!/usr/bin/env python3
"""Per-monitor workspace mapping for NeoBrix.

Hyprland workspace IDs are global. This keeps a stable, private ID range for
each physical output and presents the same local 1..N set on every display.
"""
import argparse, json, os, subprocess
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home()/".local/state")) / "neobrix/workspaces.json"

def load():
    try: return json.loads(STATE.read_text())
    except Exception: return {"enabled": False, "spaces": 5, "slots": {}}
def save(data):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temp = STATE.with_suffix(".tmp")
    temp.write_text(json.dumps(data, separators=(",", ":")) + "\n")
    os.chmod(temp, 0o600); temp.replace(STATE)
def hypr(*args):
    return subprocess.run(["hyprctl", *args], text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL).stdout
def hypr_json(*args):
    try: return json.loads(hypr("-j", *args))
    except Exception: return []
def monitors():
    try: data = json.loads(hypr("-j", "monitors"))
    except Exception: data = []
    data.sort(key=lambda m: (m.get("x", 0), m.get("y", 0), m.get("name", "")))
    return data
def key(m):
    # Connector names change through docks. A serial is best; description is a
    # useful fallback, with the connector only for anonymous virtual outputs.
    return "|".join(str(m.get(k, "")) for k in ("make", "model", "serial", "description")) or m.get("name", "")
def mapping(data):
    slots = data.setdefault("slots", {})
    used = set(slots.values())
    result = []
    for m in monitors():
        k = key(m)
        if k not in slots:
            n = 0
            while n in used: n += 1
            slots[k] = n; used.add(n)
        result.append({"name": m["name"], "id": m.get("id"), "slot": slots[k],
                       "focused": bool(m.get("focused"))})
    return result
def workspace_id(data, monitor, local):
    for m in mapping(data):
        if m["name"] == monitor: return m["slot"] * int(data["spaces"]) + local
    return local
def active_monitor(data):
    for m in mapping(data):
        if m["focused"]: return m["name"]
    return mapping(data)[0]["name"] if mapping(data) else ""
def dispatch(expr):
    # NeoBrix uses Hyprland's Lua configuration API.  In that mode the legacy
    # `hyprctl dispatch workspace 3` form is parsed as Lua and rejected; route
    # every workspace action through the native dispatcher instead.
    hypr("eval", "hl.dispatch(" + expr + ")")

def focus_workspace(workspace):
    dispatch("hl.dsp.focus({ workspace = " + json.dumps(workspace) + " })")

def move_window(workspace):
    dispatch("hl.dsp.window.move({ workspace = " + json.dumps(workspace) + ", silent = true })")

def move_named_window(address, workspace):
    dispatch("hl.dsp.window.move({ window = " + json.dumps("address:" + address) +
             ", workspace = " + json.dumps(workspace) + ", silent = true })")

def move_workspace(workspace, monitor):
    dispatch("hl.dsp.workspace.move({ workspace = " + json.dumps(workspace) +
             ", monitor = " + json.dumps(monitor) + " })")

def reconcile_slots(data):
    """Repair a saved display-to-range assignment from visible windows.

    A dock can make outputs appear in a different order than the one in which
    their slots were first saved.  On the first enable, infer an unambiguous
    existing layout from client workspace IDs rather than showing every window
    as if it belonged to the other display.
    """
    owners = mapping(data)
    candidates = [m["slot"] for m in owners]
    clients = hypr_json("clients")
    proposed = {}
    for owner in owners:
        ids = [c.get("workspace", {}).get("id") for c in clients
               if c.get("monitor") == owner["id"]]
        scores = {slot: sum(slot * int(data["spaces"]) < wid <= (slot + 1) * int(data["spaces"])
                             for wid in ids if isinstance(wid, int))
                  for slot in candidates}
        best = max(candidates, key=lambda slot: scores[slot])
        # Never guess from an empty display or a tie.  Keeping the saved slot
        # is safer than moving the indicator range without evidence.
        if scores[best] > scores[owner["slot"]] and list(scores.values()).count(scores[best]) == 1:
            proposed[owner["id"]] = best

    final = {m["id"]: proposed.get(m["id"], m["slot"]) for m in owners}
    if len(set(final.values())) != len(final):
        return
    slots = data.setdefault("slots", {})
    for raw in monitors():
        if raw.get("id") in final:
            slots[key(raw)] = final[raw["id"]]

def migrate_spaces(data, old_spaces, new_spaces):
    """Preserve each monitor's local workspaces across an ID-layout change.

    The global ID ranges are based on the workspace count.  For example, when
    changing from five to three spaces, monitor slot 1 changes from 6..10 to
    4..6.  Simply saving the new number would make its old local workspace 1
    appear as local workspace 3, and strand local workspaces 4 and 5.  Move
    every client deliberately: retained local numbers follow their new ID;
    removed local numbers collapse into local workspace 1.
    """
    owners = {m["id"]: m for m in mapping(data)}
    changes = []
    for client in hypr_json("clients"):
        owner = owners.get(client.get("monitor"))
        workspace = client.get("workspace", {}).get("id")
        address = client.get("address")
        if not owner or not isinstance(workspace, int) or not address:
            continue
        local = workspace - owner["slot"] * old_spaces
        if local < 1 or local > old_spaces:
            continue
        retained = local if local <= new_spaces else 1
        target = owner["slot"] * new_spaces + retained
        if target != workspace:
            changes.append((address, target, owner["name"]))

    # Moving a window creates a missing destination workspace.  Only then can
    # Hyprland move that workspace to its new owner.  A destination may also
    # currently belong to a different slot's old range, in which case this
    # final placement makes its ownership unambiguous.
    for address, target, _ in changes:
        move_named_window(address, target)
    for _, target, monitor in {(a, t, m) for a, t, m in changes}:
        move_workspace(target, monitor)

p = argparse.ArgumentParser(); sub = p.add_subparsers(dest="cmd")
sub.add_parser("show"); sub.add_parser("map")
for name in ("enabled", "spaces", "focus", "move", "cycle"):
    q = sub.add_parser(name); q.add_argument("value", type=int)
a = p.parse_args(); data = load(); mapping(data)
if a.cmd == "enabled":
    if bool(a.value) and not data.get("enabled"):
        reconcile_slots(data)
    data["enabled"] = bool(a.value); save(data)
elif a.cmd == "spaces":
    old_spaces = int(data.get("spaces", 5))
    new_spaces = max(3, min(10, a.value))
    if data.get("enabled") and new_spaces != old_spaces:
        migrate_spaces(data, old_spaces, new_spaces)
    data["spaces"] = new_spaces; save(data)
elif a.cmd in ("focus", "move"):
    local = max(1, min(int(data["spaces"]), a.value))
    if not data.get("enabled"):
        if a.cmd == "focus": focus_workspace(local)
        else: move_window(local)
    else:
        mon = active_monitor(data); wid = workspace_id(data, mon, local)
        if a.cmd == "focus": focus_workspace(wid)
        else: move_window(wid)
elif a.cmd == "cycle":
    if not data.get("enabled"):
        focus_workspace("e+1" if a.value > 0 else "e-1")
    else:
        mon = active_monitor(data); ids = [workspace_id(data, mon, i) for i in range(1, int(data["spaces"]) + 1)]
        try: current = json.loads(hypr("-j", "activeworkspace")).get("id")
        except Exception: current = None
        index = ids.index(current) if current in ids else 0
        wid = ids[(index + (1 if a.value > 0 else -1)) % len(ids)]
        focus_workspace(wid)
if a.cmd in ("show", "map"):
    out = {"enabled": bool(data.get("enabled")), "spaces": int(data.get("spaces", 5)), "monitors": mapping(data)}
    for m in out["monitors"]: m["ids"] = [m["slot"] * out["spaces"] + i for i in range(1, out["spaces"] + 1)]
    print(json.dumps(out, separators=(",", ":")))
