#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  Idle actions for hypridle. One place for the policy, so the timings in
#  hypridle.conf stay readable and each step can be tested on its own.
#
#      neobrix-idle dark       screen off: DPMS *and* backlight
#      neobrix-idle light      screen back on
#      neobrix-idle suspend    suspend, but only when running on battery
#
#      neobrix-idle inhibit on|off|toggle|status
#                              hold a logind lock so nothing dims, locks, blanks
#                              or suspends until it is released
#
#  Set NEOBRIX_DRY_RUN=1 to print what would happen instead of doing it.
#
#  Why `dark` turns the backlight off as well: Hyprland's `dpms off` disables
#  the CRTC, but the backlight is a separate device it does not touch, so the
#  panel goes black while still lit. Measured on an i5-11300H at 1920x1080,
#  `dpms off` on its own produced no reduction in battery draw at all and left
#  /sys/class/backlight/*/brightness at maximum. The backlight is most of what
#  a dark screen is supposed to save, so it has to be switched off explicitly.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

run() {
    if [[ -n ${NEOBRIX_DRY_RUN:-} ]]; then printf 'would run: %s\n' "$*"; return 0; fi
    "$@"
}

# `hyprctl dispatch dpms off` cannot be used: Neobrix runs a Lua config, and
# there the dispatch argument is evaluated as Lua, so `dpms off` is a syntax
# error and the command does nothing at all. That is why the idle blank had
# never worked. hl.dsp.dpms takes the state as a *string* -- passing a table
# turns the display off whatever state it names.
dpms() {
    if [[ -n ${NEOBRIX_DRY_RUN:-} ]]; then printf 'would run: dpms %s\n' "$1"; return 0; fi
    hyprctl eval "hl.dispatch(hl.dsp.dpms(\"$1\"))"
}

internal_panel_ready() {
    local want=$1 drm_enabled=true hypr_ready=false

    # DRM is the final authority on whether the connector has a live CRTC.
    # A machine without an internal panel (a desktop) has nothing to check here.
    local connector enabled
    for connector in /sys/class/drm/card*-eDP-*; do
        [[ -d $connector ]] || continue
        enabled=$(<"$connector/enabled")
        [[ $enabled == enabled ]] && drm_enabled=true || drm_enabled=false
        break
    done

    # Hyprland's state must agree. `monitors all` retains disabled outputs, so
    # select the internal panel explicitly and require a real mode when waking.
    if hyprctl -j monitors all 2>/dev/null | python -c '
import json, sys
want = sys.argv[1] == "on"
monitors = json.load(sys.stdin)
panels = [m for m in monitors if m.get("name", "").startswith("eDP-")]
if not panels:
    panels = [m for m in monitors if not m.get("disabled")]
ok = bool(panels) and all(
    bool(m.get("dpmsStatus")) == want
    and (not want or (not m.get("disabled") and m.get("width", 0) > 0 and m.get("height", 0) > 0))
    for m in panels
)
raise SystemExit(0 if ok else 1)
' "$want"; then
        hypr_ready=true
    fi

    if [[ $want == on ]]; then
        $hypr_ready && $drm_enabled
    else
        $hypr_ready
    fi
}

set_dpms_confirmed() {
    local want=$1 attempt
    if [[ -n ${NEOBRIX_DRY_RUN:-} ]]; then
        printf 'would confirm: dpms %s\n' "$want"
        return 0
    fi
    for ((attempt = 0; attempt < 40; attempt++)); do
        dpms "$want" >/dev/null 2>&1 || true
        internal_panel_ready "$want" && return 0
        sleep 0.05
    done
    printf 'neobrix-idle: internal panel did not confirm DPMS %s\n' "$want" >&2
    return 1
}

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/power.sh
source "$HERE/lib/power.sh"

# ── keep awake ───────────────────────────────────────────────────────────────
#
# A held logind inhibitor, which is the mechanism hypridle already respects:
# hypridle.conf sets ignore_systemd_inhibit = false, so while this lock is held
# it will not dim, lock, blank or suspend. Nothing here has to know the timings.
#
# The lock lives in a detached process that does nothing but hold it, so it
# survives the shell, the terminal and this script exiting. `idle:sleep` covers
# the idle chain and an explicit suspend; the lid switch is deliberately left
# alone, because "keep the screen awake" should not also mean "stay running with
# the laptop shut in a bag".
INHIBIT_PID="${XDG_RUNTIME_DIR:-/tmp}/neobrix-inhibit.pid"

inhibit_alive() {
    [[ -r $INHIBIT_PID ]] || return 1
    local pid; pid="$(cat "$INHIBIT_PID" 2>/dev/null)"
    [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

inhibit_on() {
    inhibit_alive && { echo "already awake"; return 0; }
    command -v systemd-inhibit >/dev/null 2>&1 || { printf 'neobrix-idle: systemd-inhibit not found\n' >&2; return 1; }
    # $$ inside the subshell is the process that then execs, so the pid stays
    # valid for the inhibitor itself rather than pointing at a shell that exited.
    setsid bash -c 'echo $$ > "$1"; exec systemd-inhibit \
        --what=idle:sleep --who=Neobrix --why="Keep awake" --mode=block \
        sleep infinity' _ "$INHIBIT_PID" </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
    sleep 0.3
    inhibit_alive && echo "staying awake" || { printf 'neobrix-idle: could not hold the lock\n' >&2; return 1; }
}

inhibit_off() {
    if ! inhibit_alive; then rm -f "$INHIBIT_PID"; echo "not held"; return 0; fi
    local pid; pid="$(cat "$INHIBIT_PID")"
    # The group, because the inhibitor has a `sleep` of its own to take with it.
    kill -- -"$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    rm -f "$INHIBIT_PID"
    echo "idle timers back on"
}

case ${1:-} in
    dark)
        # Backlight first, and a DPMS failure is not fatal: the backlight is
        # what actually saves the power, so it must not be skipped because the
        # compositor refused the blank.
        #
        # No -s: the dim listener already saved the user's real brightness on
        # its way down, and saving again here would store the dimmed value and
        # restore to that instead.
        command -v brightnessctl >/dev/null 2>&1 && run brightnessctl -q set 0
        run dpms off || true
        ;;
    light)
        if command -v brightnessctl >/dev/null 2>&1; then
            # -r restores what the dim step saved on the way down, which is the
            # brightness the user actually chose. If there is nothing saved --
            # the dim listener never ran, or its state was lost -- restoring
            # leaves the backlight at the 0 `dark` set, i.e. a screen that stays
            # black after a keypress. Anything visible beats that.
            run brightnessctl -q -r || true
            if [[ -z ${NEOBRIX_DRY_RUN:-} && $(brightnessctl get) -eq 0 ]]; then
                brightnessctl -q set 50%
            fi
        fi
        # A successful command is not proof that the resumed output consumed
        # it: Hyprland can acknowledge DPMS against its pre-suspend state while
        # the CRTC is still being recreated. Force and observe a fresh state
        # transition, then return only once Hyprland and DRM both say it is on.
        set_dpms_confirmed off || true
        set_dpms_confirmed on || true
        ;;
    suspend)
        if neobrix_on_battery; then
            run systemctl suspend
        else
            printf 'on mains, not suspending\n'
        fi
        ;;
    inhibit)
        case ${2:-status} in
            on|start)   inhibit_on ;;
            off|stop)   inhibit_off ;;
            toggle)     if inhibit_alive; then inhibit_off; else inhibit_on; fi ;;
            status)
                # Self-healing: a pid file left behind by a crash would
                # otherwise have the shell showing "awake" forever.
                if inhibit_alive; then echo on; else rm -f "$INHIBIT_PID"; echo off; exit 1; fi
                ;;
            *) die "inhibit takes on, off, toggle or status" ;;
        esac
        ;;

    on-battery)
        # Exposed so the guard above can be checked without suspending anything.
        neobrix_on_battery && { echo yes; exit 0; } || { echo no; exit 1; }
        ;;
    *)
        sed -n '2,13p' "$(readlink -f "$0")" | sed 's/^# \?//'
        exit 1
        ;;
esac
