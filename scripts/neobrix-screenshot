#!/usr/bin/env bash
# Wayland screenshots for Hyprland.
#
#   neobrix-screenshot region   select a region
#   neobrix-screenshot screen   the focused monitor
#   neobrix-screenshot window   the focused window
#   neobrix-screenshot edit     select a region, then open it in satty
#
# Every capture is saved to ~/Pictures/Screenshots AND copied to the clipboard,
# and a notification with a preview is sent.

set -euo pipefail

MODE="${1:-region}"
DIR="${NEOBRIX_SCREENSHOT_DIR:-$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots}"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"

notify() {
    # -i takes an image path, which the shell renders as a real preview.
    notify-send -a "Screenshot" -i "$2" "$1" "${3:-$FILE}" 2>/dev/null || true
}

fail() {
    notify-send -a "Screenshot" -u critical "Screenshot failed" "$1" 2>/dev/null || true
    printf 'neobrix-screenshot: %s\n' "$1" >&2
    exit 1
}

command -v grim >/dev/null || fail "grim is not installed"

# The focused monitor's name, for whole-screen captures.
focused_output() {
    hyprctl -j monitors | python -c '
import json,sys
for m in json.load(sys.stdin):
    if m.get("focused"): print(m["name"]); break'
}

# The focused window geometry as an "X,Y WxH" string for grim -g.
focused_window_geometry() {
    hyprctl -j activewindow | python -c '
import json,sys
w=json.load(sys.stdin)
if not w or "at" not in w: sys.exit(1)
x,y=w["at"]; cw,ch=w["size"]
print(f"{x},{y} {cw}x{ch}")'
}

case "$MODE" in
    region|edit)
        command -v slurp >/dev/null || fail "slurp is not installed"
        # Brutalist selection box: thick peach border, no fill.
        geom=$(slurp -d -b 00000040 -c f6a97eff -w 3 2>/dev/null) || exit 0
        [[ -n "$geom" ]] || exit 0
        grim -g "$geom" "$FILE" || fail "grim failed"
        ;;
    screen|output|full)
        out=$(focused_output) || fail "could not determine the focused output"
        grim -o "$out" "$FILE" || fail "grim failed"
        ;;
    window)
        geom=$(focused_window_geometry) || fail "no focused window"
        grim -g "$geom" "$FILE" || fail "grim failed"
        ;;
    *)
        fail "unknown mode: $MODE (use region|screen|window|edit)"
        ;;
esac

# wl-copy forks a daemon that owns the clipboard selection until it is
# replaced. That child inherits our stdout/stderr, so a scripted or piped
# invocation of this script appears to hang forever even though the capture
# already succeeded. Detaching its fds releases the caller.
wl-copy --type image/png >/dev/null 2>&1 < "$FILE"

if [[ "$MODE" == "edit" ]]; then
    if command -v satty >/dev/null; then
        satty --filename "$FILE" --output-filename "$FILE" --early-exit --copy-command wl-copy
        notify "Screenshot edited" "$FILE"
        exit 0
    fi
    notify "Screenshot saved" "$FILE" "satty is not installed — saved unedited"
    exit 0
fi

notify "Screenshot saved" "$FILE"
