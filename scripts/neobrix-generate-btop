#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  Builds the Neobrix theme for btop and points btop at it.
#
#      neobrix-generate-btop [dawn|dusk]
#
#  Colours come from lib/palette.sh — the same values the shell, terminals, GTK,
#  Qt, the login screen and the browser chrome are drawn from, so btop is the
#  same desktop rather than a lookalike.
#
#  btop's theme format is a flat list of `theme[key]="#rrggbb"`. Most keys are a
#  single colour; nine of them are three-stop gradients (start/mid/end) that btop
#  interpolates across a meter or graph. Those are where the work is: a gradient
#  has to say something about the value it is showing, so the ones that mean
#  "more is worse" (cpu, temp, used memory, process load) ramp calm to alarming,
#  and the ones that mean "more is fine" (free, available, cached) do not ramp at
#  all -- they stay one hue, because a green bar turning red for having lots of
#  free memory would be a lie.
#
#  Only btop.conf's three theme-related keys are touched, in place. The rest of
#  the file is somebody's own configuration -- update intervals, which boxes are
#  shown, sort order -- and is left exactly as it is.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/palette.sh
source "$HERE/lib/palette.sh"

MODE="${1:-dawn}"
[[ "$MODE" == "dawn" || "$MODE" == "dusk" ]] || {
    echo "usage: neobrix-generate-btop [dawn|dusk]" >&2; exit 2; }

command -v btop >/dev/null 2>&1 || exit 0   # nothing to theme

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
BTOP="$CFG/btop"
THEME="$BTOP/themes/neobrix.theme"
CONF="$BTOP/btop.conf"

neobrix_palette "$MODE"

mkdir -p "$BTOP/themes"

# Meters and graph fills sit on the deep tone rather than the background: btop
# draws them inside boxes, and an unfilled meter should read as a well rather
# than as a hole in the page.
cat > "$THEME.tmp" <<EOF
# Neobrix ($MODE) — generated by neobrix-generate-btop.
# Edits are overwritten. Change the palette in scripts/lib/palette.sh instead,
# or switch modes with \`neobrix theme set dawn|dusk\`.

# Empty on purpose, with theme_background = False below: btop then inherits the
# terminal's background instead of painting its own. kitty is already drawn from
# this palette, so painting a second background over it only risks the two being
# a shade apart -- and it would defeat any transparency the terminal is set up
# with.
theme[main_bg]=""
theme[main_fg]="#$FG"
theme[title]="#$FG"
theme[hi_fg]="#$PRIMARY"
theme[selected_bg]="#$PRIMARY"
theme[selected_fg]="#$ON_ACCENT"
theme[inactive_fg]="#$FG_DIM"
theme[graph_text]="#$FG_DIM"
theme[meter_bg]="#$BG_DEEP"
theme[proc_misc]="#$SECONDARY"

# The boxes are the chunky outline the rest of the desktop is drawn with.
theme[cpu_box]="#$OUTLINE"
theme[mem_box]="#$OUTLINE"
theme[net_box]="#$OUTLINE"
theme[proc_box]="#$OUTLINE"
theme[div_line]="#$OUTLINE"

# More is worse: calm to alarming.
theme[cpu_start]="#$SECONDARY"
theme[cpu_mid]="#$WARNING"
theme[cpu_end]="#$ERROR"

theme[temp_start]="#$INFO"
theme[temp_mid]="#$WARNING"
theme[temp_end]="#$ERROR"

theme[used_start]="#$SECONDARY"
theme[used_mid]="#$WARNING"
theme[used_end]="#$ERROR"

theme[process_start]="#$SECONDARY"
theme[process_mid]="#$WARNING"
theme[process_end]="#$ERROR"

# More is fine: one hue, flat. A bar that reddens for having plenty spare would
# be telling you the opposite of the truth.
theme[free_start]="#$SECONDARY"
theme[free_mid]="#$SECONDARY"
theme[free_end]="#$SECONDARY"

theme[available_start]="#$INFO"
theme[available_mid]="#$INFO"
theme[available_end]="#$INFO"

theme[cached_start]="#$TERTIARY"
theme[cached_mid]="#$TERTIARY"
theme[cached_end]="#$TERTIARY"

# The process box's own states. A missing key here does not fail loudly: btop
# falls back to a built-in colour for that one element, so a followed process or
# a paused list comes out in somebody else's palette.
theme[proc_banner_bg]="#$BG_DEEP"
theme[proc_banner_fg]="#$FG"
theme[proc_follow_bg]="#$TERTIARY"
theme[followed_bg]="#$TERTIARY"
theme[followed_fg]="#$ON_ACCENT"
theme[proc_pause_bg]="#$WARNING"

# Traffic, distinguished by direction rather than by severity.
theme[download_start]="#$INFO"
theme[download_mid]="#$INFO"
theme[download_end]="#$TERTIARY"

theme[upload_start]="#$PINK"
theme[upload_mid]="#$PINK"
theme[upload_end]="#$PRIMARY"
EOF
mv "$THEME.tmp" "$THEME"

# ── point btop at it, without touching anything else ─────────────────────────
#
# btop rewrites btop.conf itself on exit, so this has to be a targeted edit of
# the three keys rather than a generated file: anything else here belongs to
# whoever configured it.
set_key() {
    local key="$1" value="$2"
    [[ -f $CONF ]] || { printf '%s = %s\n' "$key" "$value" >> "$CONF"; return; }
    if grep -qE "^[[:space:]]*$key[[:space:]]*=" "$CONF"; then
        # A value containing / or & would break the replacement; none of these do,
        # but the pattern is written so a future one cannot.
        python3 - "$CONF" "$key" "$value" <<'PY'
import re, sys
path, key, value = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    text = f.read()
text = re.sub(r"(?m)^[ \t]*%s[ \t]*=.*$" % re.escape(key), "%s = %s" % (key, value), text, count=1)
with open(path, "w") as f:
    f.write(text)
PY
    else
        printf '%s = %s\n' "$key" "$value" >> "$CONF"
    fi
}

mkdir -p "$BTOP"
set_key color_theme '"neobrix"'
# The palette is not a 256-colour approximation of anything.
set_key truecolor 'True'
# False means "let the terminal's background through", which is what the empty
# main_bg above is for.
set_key theme_background 'False'

printf 'wrote %s and pointed btop at it (%s)\n' "$THEME" "$MODE"

# A running btop reloads its theme from the menu, not on a signal, so say so
# rather than leaving someone wondering why nothing changed.
if pgrep -x btop >/dev/null 2>&1; then
    printf 'btop is running: it picks this up on restart\n'
fi
