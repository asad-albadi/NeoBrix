#!/usr/bin/env python3
"""Generate the Neobrix fastfetch config.

Icons are written by codepoint rather than pasted as glyphs: every BMP
Private-Use character (cpu, memory, kernel, shell, terminal…) was silently
dropped when the file was authored by hand, leaving bare tree connectors. The
font has all of them — only Omarchy's own U+E900 branding glyph is absent.
 
Icon choices were verified by rasterising each candidate, not by fc-scan: its
charset ranges are coarse enough to claim a codepoint exists when the font has no
outline for it. U+F17C5 (md-linux) passed that check and rendered as a "PM"
fallback. OS is the Arch mark (CachyOS is Arch-based), kernel is Tux, and memory
is the RAM-stick glyph so it no longer duplicates the CPU chip.
"""
import json, pathlib, re

g = lambda cp: chr(int(cp, 16))
BS = chr(92)

ICON = {
    "host": "F109", "cpu": "F4BC", "gpu": "F0878", "display": "F1104",
    "memory": "EFC5", "swap": "F04E1", "disk": "F02CA",
    "os": "F303", "kernel": "F31A", "wm": "F013", "shell": "F488",
    "terminal": "F489", "packages": "F03D6",
    "palette": "F0E0C", "theme": "F027C", "icons": "F003B",
    "termfont": "F031", "cursor": "F01C0",
    "age": "F199F", "uptime": "F1AD0", "update": "EB29",
}

MID, END = "│ ├", "└ └"
GREY = "\\u001b[90m"

def rule(title=""):
    inner = 52
    if not title:
        return {"type": "custom", "format": GREY + "└" + "─" * inner + "┘"}
    pad = inner - len(title)
    left = pad // 2
    return {"type": "custom",
            "format": GREY + "┌" + "─" * left + title + "─" * (pad - left) + "┐"}

def row(mtype, icon, color, first=False, last=False, label=None, **extra):
    if first:
        key = f"{g(icon)} {label}"
    else:
        key = (END if last else MID) + g(icon)
    m = {"type": mtype, "key": key, "keyColor": color}
    m.update(extra)
    return m

dots = "".join(f"{BS}033[{c}m●" for c in (33, 32, 35, 95, 34, 36))
palette_cmd = (
    'm=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/neobrix/theme" 2>/dev/null); '
    '[ -n "$m" ] || m=dawn; '
    "printf '%s  " + dots + BS + "033[0m' \"$m\""
)
age_cmd = ('b=$(stat -c %W / 2>/dev/null); '
           'if [ -n "$b" ] && [ "$b" -gt 0 ]; then '
           'echo "$(( ($(date +%s) - b) / 86400 )) days"; else echo unknown; fi')
upd_cmd = ('n=$(checkupdates 2>/dev/null | wc -l); '
           'if [ "$n" -gt 0 ]; then echo "$n packages"; else echo "up to date"; fi')

modules = [
    "break",
    rule("Hardware"),
    row("host", ICON["host"], "green", first=True, label="PC"),
    row("cpu", ICON["cpu"], "green", showPeCoreCount=True),
    row("gpu", ICON["gpu"], "green", detectionMethod="pci"),
    row("display", ICON["display"], "green"),
    row("memory", ICON["memory"], "green"),
    row("swap", ICON["swap"], "green"),
    row("disk", ICON["disk"], "green", last=True),
    rule(),
    "break",
    rule("Software"),
    row("os", ICON["os"], "magenta", first=True, label="OS"),
    row("kernel", ICON["kernel"], "magenta"),
    row("wm", ICON["wm"], "magenta"),
    row("shell", ICON["shell"], "magenta"),
    row("terminal", ICON["terminal"], "magenta"),
    row("packages", ICON["packages"], "magenta", last=True),
    rule(),
    "break",
    rule("Desktop"),
    {"type": "command", "key": f"{g(ICON['palette'])} Neobrix",
     "keyColor": "yellow", "text": palette_cmd},
    row("theme", ICON["theme"], "yellow"),
    row("icons", ICON["icons"], "yellow"),
    row("terminalfont", ICON["termfont"], "yellow"),
    row("cursor", ICON["cursor"], "yellow", last=True),
    rule(),
    "break",
    rule("Age / Uptime / Update"),
    {"type": "command", "key": f"{g(ICON['age'])} OS Age", "keyColor": "blue", "text": age_cmd},
    {"type": "uptime", "key": f"{g(ICON['uptime'])} Uptime", "keyColor": "blue"},
    {"type": "command", "key": f"{g(ICON['update'])} Update", "keyColor": "blue", "text": upd_cmd},
    rule(),
    "break",
]

cfg = {
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {"type": "auto", "padding": {"top": 2, "right": 5, "left": 2}},
    "display": {"separator": "  ", "color": {"keys": "white"}},
    "modules": modules,
}

body = json.dumps(cfg, indent=2, ensure_ascii=False)
#  must reach fastfetch as an escape sequence, not a literal backslash-u.
body = body.replace("\\\\u001b", "\\u001b")

header = """// Neobrix fastfetch layout.
//
// Grouped into boxed sections with tree-style keys instead of one flat list. The
// layout grammar — grey box rules, "| |-" continuation keys, one colour per
// section — is modelled on Omarchy's fastfetch config; the modules, icons,
// colours and commands are Neobrix's own.
//
// The logo is left on auto-detect, so this keeps the distro's own logo.
//
// Section colours are ANSI names, not hex, on purpose: the terminal palette is
// generated by `neobrix-theme` from the same source as the shell, so "green"
// here IS Neobrix pistachio and the whole readout follows a dawn/dusk switch
// without this file knowing anything about it.
//   hardware -> green   (pistachio)
//   software -> magenta (lavender)
//   desktop  -> yellow  (peach)
//   age      -> blue    (info)
//
// GENERATED — regenerate with scripts/neobrix-generate-fastfetch rather than
// hand-editing: the Nerd Font icons are Private-Use codepoints that do not
// survive being pasted around.
"""

out = pathlib.Path(__file__).resolve().parent.parent / "terminal/fastfetch/config.jsonc"
out.write_text(header + body + "\n")

# verify
d = json.loads(re.sub(r"^\s*//.*$", "", out.read_text(), flags=re.M))
print("parsed ok -", len(d["modules"]), "modules")
missing = [m["type"] for m in d["modules"]
           if isinstance(m, dict) and "key" in m
           and not any(ord(c) > 0xE000 for c in m["key"])]
print("rows without an icon:", missing or "none")
